local function setFollowerCount()
    if busy then return end
    if not current then setStatus("Select a player first."); return end

    local wanted=tonumber(targetBox.Text)
    if not wanted or wanted<0 then setStatus("Enter a valid target count."); return end
    wanted=math.floor(wanted)

    busy=true
    local targetKey=tostring(current.uid)
    local existing=get(FOLLOWERS.."/"..esc(targetKey)..".json") or {}
    if type(existing)~="table" then existing={} end

    local keys={}
    for uid in pairs(existing) do table.insert(keys,tostring(uid)) end
    local count=#keys
    local added,removed=0,0

    -- Decrease/reset: delete real follower records until the requested count is reached.
    if count>wanted then
        setStatus(string.format("Reducing %s: %d → %d...",current.name,count,wanted))
        for _,uid in ipairs(keys) do
            if count<=wanted then break end
            if del(FOLLOWERS.."/"..esc(targetKey).."/"..esc(uid)..".json") then
                count-=1
                removed+=1
            end
        end
    -- Increase: use available TOP-listed account IDs not already following the target.
    elseif count<wanted then
        setStatus(string.format("Increasing %s: %d → %d...",current.name,count,wanted))
        for _,row in ipairs(topRows) do
            if count>=wanted then break end
            local uid=tostring(row.uid)
            if uid~=targetKey and existing[uid]==nil then
                if put(FOLLOWERS.."/"..esc(targetKey).."/"..esc(uid)..".json",true) then
                    existing[uid]=true
                    count+=1
                    added+=1
                end
            end
        end
    end

    busy=false
    render()
    if count==wanted then
        setStatus(string.format("Done. %s now has exactly %d followers.\nAdded: %d   Removed: %d",current.name,count,added,removed))
    else
        setStatus(string.format("Stopped at %d; target was %d.\nAvailable TOP accounts may be insufficient.",count,wanted))
    end
end

local function sendCustomFollow()
    if busy then return end
    if not current then setStatus("Select a player first."); return end

    local username=customBox.Text:gsub("^%s+",""):gsub("%s+$","")
    if username=="" then setStatus("Enter a custom follower username."); return end
    if #username>80 then setStatus("Username is too long (max 80 characters)."); return end
    if username==tostring(current.name) then
        setStatus("The selected player cannot follow themselves."); return
    end

    busy=true
    local targetKey=tostring(current.uid)
    local followerKey=esc(username)
    local existing=get(FOLLOWERS.."/"..esc(targetKey).."/"..followerKey..".json")

    if existing~=nil then
        busy=false
        setStatus(string.format("Custom follower already exists: %s",username))
        return
    end

    setStatus(string.format("Adding custom follower %s to %s...",username,current.name))
    local ok=put(FOLLOWERS.."/"..esc(targetKey).."/"..followerKey..".json",true)
    busy=false
    render()

    if ok then
        customBox.Text=""
        setStatus(string.format("Done. %s was added as a follower of %s.",username,current.name))
    else
        setStatus("Failed to write the custom follower record. Check Firebase rules / HTTP access.")
    end
end

local function removeTopFollowers()
    if busy then return end
    if not current then setStatus("Select a player first."); return end

    busy=true
    local targetKey=tostring(current.uid)
    local existing=get(FOLLOWERS.."/"..esc(targetKey)..".json") or {}
    if type(existing)~="table" then existing={} end

    local removed=0
    for _,row in ipairs(topRows) do
        local uid=tostring(row.uid)
        if uid~=targetKey and existing[uid]~=nil then
            if del(FOLLOWERS.."/"..esc(targetKey).."/"..esc(uid)..".json") then
                removed+=1
            end
        end
    end

    busy=false
    render()
    setStatus(string.format("Finished.\nRemoved %d TOP follower records from %s.",removed,current.name))
end

