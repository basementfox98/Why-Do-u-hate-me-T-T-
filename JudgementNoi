local CoreGui = game:GetService("CoreGui")
local UIS = game:GetService("UserInputService")

local FIREBASE = "https://ares-chat-f7794-default-rtdb.firebaseio.com"
local FOLLOWERS = FIREBASE .. "/followers"
local PROFILES = FIREBASE .. "/profiles"

local http = syn and syn.request or (http and http.request) or request
if not http then warn("[Ares TOP Tester] Executor HTTP request function not found."); return end

local function req(url, method, body)
    local ok, res = pcall(http, {
        Url = url, Method = method or "GET",
        Headers = body and {["Content-Type"]="application/json"} or nil,
        Body = body
    })
    if not ok or not res then return false, nil end
    local data
    if res.Body and res.Body ~= "" and res.Body ~= "null" then
        pcall(function() data = HttpService:JSONDecode(res.Body) end)
    end
    return (res.Success == true) or (tonumber(res.StatusCode) and tonumber(res.StatusCode) >= 200 and tonumber(res.StatusCode) < 300), data
end

local function get(url)
    local ok, data = req(url, "GET")
    return ok and data or nil
end

local function put(url, value)
    local ok = req(url, "PUT", HttpService:JSONEncode(value))
    return ok
end

local function del(url)
    local ok = req(url, "DELETE")
    return ok
end

local function esc(s)
    return tostring(s):gsub("([^%w_%-%.~])", function(c)
        return string.format("%%%02X", string.byte(c))
    end)
end

-- Same basic TOP calculation used by Ares:
-- count children under followers/<user>, then sort descending.
local function buildTop()
    local followers = get(FOLLOWERS .. ".json") or {}
    local profiles = get(PROFILES .. ".json") or {}
    local rows = {}

    for uid, list in pairs(followers) do
        if type(list) == "table" then
            local count = 0
            for _ in pairs(list) do count += 1 end
            local n = tonumber(uid)
            if n and count > 0 then
                local p = type(profiles[uid]) == "table" and profiles[uid] or {}
                table.insert(rows, {
                    uid=n, key=tostring(uid), count=count,
                    name=p.displayName or p.username or ("User "..uid)
                })
            end
        end
    end

    table.sort(rows, function(a,b)
        if a.count == b.count then return a.uid < b.uid end
        return a.count > b.count
    end)
    return rows
end

