local function SelectTab(name)
    CurrentTab = name

    for tabName, button in pairs(TabButtons) do
        local selected = tabName == name
        button.BackgroundColor3 = selected and ACCENT_DARK or PANEL
        button.TextColor3 = selected and TEXT or SUBTEXT
    end

    RenderCurrentTab()
end

