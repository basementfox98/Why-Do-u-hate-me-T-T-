local function updateScale()

    local camera =
        workspace.CurrentCamera

    if not camera then
        return
    end

    local viewport =
        camera.ViewportSize

    local scale =
        math.min(
            viewport.X / 760,
            viewport.Y / 520
        )

    UIScale.Scale =
        math.clamp(
            scale,
            0.70,
            1
        )

