local function create(className, props, parent)
    local obj = Instance.new(className)
    for k,v in pairs(props or {}) do
        pcall(function() obj[k] = v end)
    end
    obj.Parent = parent
    return obj
end

local function corner(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 10)
    c.Parent = obj
    return c
end

local function stroke(obj, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.fromRGB(210,195,225)
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0.2
    s.Parent = obj
    return s
end

local function safeSetClipboard(text)
    local f = setclipboard or toclipboard or (syn and syn.write_clipboard)
    if type(f) == "function" then
        pcall(function() f(tostring(text)) end)
        return true
    end
    return false
end

local Toast

local function toast(text)
    if not Toast then return end
    Toast.Text = tostring(text)
    Toast.Visible = true
    Toast.TextTransparency = 0
    local id = os.clock()
    Toast:SetAttribute("ToastId", id)
    task.delay(1.8, function()
        if Toast and Toast.Parent and Toast:GetAttribute("ToastId") == id then
            Toast.Visible = false
        end
    end)
end

local function getCharacter()
    local c = player.Character
    if not c then return nil end
    return c
end

local function getHumanoid()
    local c = getCharacter()
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function getAnimator()
    local humanoid = getHumanoid()
    if not humanoid then return nil end

    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end

    return animator
end

local function numericId(value)
    if value == nil then return nil end
    local s = tostring(value)
    return tonumber(s:match("%d+"))
end

--==============================================================
-- PERSISTENT SAVED / FAVORITE / RECENT EMOTES
--==============================================================
local function rebuildSavedSet()
    State.SavedSet = {}
    for _, item in ipairs(State.Saved) do
        local id = numericId(item.Id or item.AssetId)
        if id then State.SavedSet[id] = true end
    end
end

local function rebuildFavoriteSet()
    State.FavoriteSet = {}
    for _, item in ipairs(State.Favorites) do
        local id = numericId(item.Id or item.AssetId)
        if id then State.FavoriteSet[id] = true end
    end
end

local function normalizeEmote(item)
    if type(item) ~= "table" then return nil end
    local id = numericId(item.Id or item.id or item.AssetId or item.assetId)
    if not id then return nil end
    local assetId = numericId(item.AssetId or item.assetId) or id
    return {
        Id = id,
        AssetId = assetId,
        Name = tostring(item.Name or item.name or ("Emote " .. id)),
        AnimationId = item.AnimationId or ("rbxassetid://" .. tostring(assetId)),
    }
end

local function loadSaved()
    State.Saved = {}
    State.Favorites = {}
    State.Recent = {}

    pcall(function()
        if type(isfile) ~= "function" or not isfile(SAVE_FILE)
            or type(readfile) ~= "function" then
            return
        end

        local decoded = HttpService:JSONDecode(readfile(SAVE_FILE))
        if type(decoded) ~= "table" then return end

        -- Backward compatible with v16's plain saved-emote array.
        if #decoded > 0 then
            for _, item in ipairs(decoded) do
                local normalized = normalizeEmote(item)
                if normalized then table.insert(State.Saved, normalized) end
            end
        else
            for _, item in ipairs(decoded.saved or {}) do
                local normalized = normalizeEmote(item)
                if normalized then table.insert(State.Saved, normalized) end
            end
            for _, item in ipairs(decoded.favorites or {}) do
                local normalized = normalizeEmote(item)
                if normalized then table.insert(State.Favorites, normalized) end
            end
            for _, item in ipairs(decoded.recent or {}) do
                local normalized = normalizeEmote(item)
                if normalized then table.insert(State.Recent, normalized) end
            end
        end
    end)

    rebuildSavedSet()
    rebuildFavoriteSet()
end

local function saveData()
    rebuildSavedSet()
    rebuildFavoriteSet()

    pcall(function()
        if type(writefile) == "function" then
            writefile(SAVE_FILE, HttpService:JSONEncode({
                saved = State.Saved,
                favorites = State.Favorites,
                recent = State.Recent,
            }))
        end
    end)
end

local function findSaved(id)
    id = numericId(id)
    for i,item in ipairs(State.Saved) do
        if numericId(item.Id or item.AssetId) == id then
            return i,item
        end
    end
end

local function findFavorite(id)
    id = numericId(id)
    for i,item in ipairs(State.Favorites) do
        if numericId(item.Id or item.AssetId) == id then
            return i,item
        end
    end
end

local function addSaved(item)
    local normalized = normalizeEmote(item)
    if not normalized then return end
    if findSaved(normalized.Id) then
        toast("Already saved")
        return
    end
    table.insert(State.Saved, normalized)
    saveData()
    toast("Saved • " .. normalized.Name)
end

local function removeSaved(id)
    local index = findSaved(id)
    if not index then return end
    table.remove(State.Saved, index)
    saveData()
    toast("Removed from Saved")
end

local function addFavorite(item)
    local normalized = normalizeEmote(item)
    if not normalized then return end
    if findFavorite(normalized.Id) then return end
    table.insert(State.Favorites, normalized)
    saveData()
    toast("Added to Favorites")
end

local function removeFavorite(id)
    local index = findFavorite(id)
    if not index then return end
    table.remove(State.Favorites, index)
    saveData()
    toast("Removed from Favorites")
end

local function toggleFavorite(item)
    local id = numericId(item.Id or item.AssetId)
    if not id then return end
    if findFavorite(id) then
        removeFavorite(id)
    else
        addFavorite(item)
    end
end

local function addRecent(item)
    local normalized = normalizeEmote(item)
    if not normalized then return end
    for i = #State.Recent, 1, -1 do
        if numericId(State.Recent[i].Id or State.Recent[i].AssetId) == normalized.Id then
            table.remove(State.Recent, i)
        end
    end
    table.insert(State.Recent, 1, normalized)
    while #State.Recent > MAX_RECENT do
        table.remove(State.Recent)
    end
    saveData()
end

loadSaved()

