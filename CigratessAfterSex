--============================================================
-- HELPERS
--============================================================

local function New(className, props, parent)
    local object = Instance.new(className)
    for k, v in pairs(props or {}) do object[k] = v end
    if parent then object.Parent = parent end
    return object
end

local function Corner(object, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = object
    return c
end

local function Stroke(object, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or DARK_RED
    s.Thickness = thickness or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = object
    return s
end

local function TextGradient(object)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, WHITE),
        ColorSequenceKeypoint.new(0.52, SOFT_WHITE),
        ColorSequenceKeypoint.new(1, RED),
    })
    g.Parent = object
    return g
end

local function MovingBorder(object, thickness)
    local stroke = Stroke(object, RED, thickness or 1.5)
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, BLACK),
        ColorSequenceKeypoint.new(0.30, BRIGHT_RED),
        ColorSequenceKeypoint.new(0.50, BLACK),
        ColorSequenceKeypoint.new(0.72, BRIGHT_RED),
        ColorSequenceKeypoint.new(1, BLACK),
    })
    gradient.Parent = stroke

    task.spawn(function()
        while object.Parent and stroke.Parent do
            local tween = TweenService:Create(
                gradient,
                TweenInfo.new(2.5, Enum.EasingStyle.Linear),
                {Rotation = gradient.Rotation + 360}
            )
            tween:Play()
            tween.Completed:Wait()
        end
    end)
    return stroke
end

local function Safe(fn, ...)
    local ok, result = pcall(fn, ...)
    if ok then return result end
    return nil
end

local function AssetId(value)
    return tonumber(tostring(value):match("%d+"))
end

local function Thumbnail(id)
    return "rbxthumb://type=Asset&id=" .. tostring(id) .. "&w=420&h=420"
end

--============================================================
-- LOCAL FAVORITES
--============================================================

local function LoadFavorites()
    Favorites = {}
    FavoritesSet = {}

    local ok, data = pcall(function()
        if readfile and isfile and isfile(SAVE_FILE) then
            return HttpService:JSONDecode(readfile(SAVE_FILE))
        end
        return {}
    end)

    if not ok or type(data) ~= "table" then return end

    for _, id in ipairs(data) do
        id = tonumber(id)
        if id and not FavoritesSet[id] then
            FavoritesSet[id] = true
            table.insert(Favorites, id)
        end
    end
end

local function SaveFavorites()
    pcall(function()
        if writefile then
            writefile(SAVE_FILE, HttpService:JSONEncode(Favorites))
        end
    end)
end

LoadFavorites()

local function IsFavorite(id)
    return FavoritesSet[id] == true
end

local function ToggleFavorite(id)
    id = tonumber(id)
    if not id then return end

    if IsFavorite(id) then
        FavoritesSet[id] = nil
        for i, value in ipairs(Favorites) do
            if value == id then
                table.remove(Favorites, i)
                break
            end
        end
    else
        FavoritesSet[id] = true
        table.insert(Favorites, id)
    end

    SaveFavorites()
end

