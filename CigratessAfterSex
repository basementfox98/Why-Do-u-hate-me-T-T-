--// ANIMATION PLAYER
local function stopCurrentEmote()
    if State.CurrentTrack then
        pcall(function()
            State.CurrentTrack:Stop(0.1)
        end)

        State.CurrentTrack = nil
    end
end

local function playEmote(assetId, name)
    if not assetId then
        return
    end

    assetId = tonumber(assetId)

    if not assetId then
        return
    end

    stopCurrentEmote()

    local animationId = "rbxassetid://" .. tostring(assetId)

    -- Try resolving the real animation object first,
    -- just like the supplied GazeOld source.
    pcall(function()
        local objects = game:GetObjects(animationId)

        if objects and #objects > 0 then
            local object = objects[1]

            if object:IsA("Animation") then
                animationId = object.AnimationId
            end
        end
    end)

    local animation = Instance.new("Animation")
    animation.AnimationId = animationId

    local track

    local success, result = pcall(function()
        return Humanoid:LoadAnimation(animation)
    end)

    if not success or not result then
        animation:Destroy()

        showToast("Could not load emote")
        return
    end

    track = result

    if Settings.HighPriority then
        track.Priority = Enum.AnimationPriority.Action4
    else
        track.Priority = Enum.AnimationPriority.Action
    end

    -- Stop other animations with a lower/different priority.
    if Settings.HighPriority then
        pcall(function()
            for _, playingTrack in ipairs(
                Humanoid:GetPlayingAnimationTracks()
            ) do
                if playingTrack ~= track
                    and playingTrack.Priority ~= track.Priority then

                    playingTrack:Stop(0.1)
                end
            end
        end)
    end

    local speed = math.clamp(
        tonumber(Settings.Speed) or 1,
        0.05,
        5
    )

    pcall(function()
        track.Looped = Settings.Looped
        track:Play(0.1, 1, speed)
    end)

    State.CurrentTrack = track

    showToast(
        "Playing • " .. tostring(name or "Emote")
    )

    animation:Destroy()
end

