local function SelectTab(tab)
    CurrentTab = tab

    local emotesActive = tab == "Emotes"
    local favoritesActive = tab == "Favorites"
    local copyActive = tab == "Copy"
    local settingsActive = tab == "Settings"

    TabEmotes.BackgroundColor3 = emotesActive and GLASS_2 or BLACK_2
    TabFavorites.BackgroundColor3 = favoritesActive and GLASS_2 or BLACK_2
    TabCopy.BackgroundColor3 = copyActive and GLASS_2 or BLACK_2
    TabSettings.BackgroundColor3 = settingsActive and GLASS_2 or BLACK_2

    -- Dedicated labels are always bright white with a subtle dark outline.
    -- They are independent of the tab surface gradient, so all three names
    -- remain readable regardless of theme, gradient position, or selection.
    TabEmotesLabel.TextColor3 = WHITE
    TabFavoritesLabel.TextColor3 = WHITE
    TabCopyLabel.TextColor3 = WHITE
    TabSettingsLabel.TextColor3 = WHITE
    TabEmotesLabel.TextTransparency = 0
    TabFavoritesLabel.TextTransparency = 0
    TabCopyLabel.TextTransparency = 0
    TabSettingsLabel.TextTransparency = 0

    EmoteTabStroke.Color = emotesActive and RED or DARK_RED
    FavoriteTabStroke.Color = favoritesActive and RED or DARK_RED
    CopyTabStroke.Color = copyActive and RED or DARK_RED
    SettingsTabStroke.Color = settingsActive and RED or DARK_RED
    RefreshActiveTabGradient()

    -- Never leave the catalog/search layer sitting over Settings.
    SearchHolder.Visible = emotesActive
    GridHolder.Visible = emotesActive or favoritesActive
    CopyScroll.Visible = copyActive
    CopyRefreshButton.Visible = copyActive
    SettingsScroll.Visible = settingsActive

    if emotesActive then
        PageArea.Visible = true
        PrevPage.Visible = true
        NextPage.Visible = true

        -- Returning to EMOTES must preserve the page the user was on.
        -- Only load page 1 on the very first entry, or when there is no
        -- cached/current catalog state yet. Switching tabs must not reset it.
        if not CatalogCache[SearchQuery] or not CatalogCache[SearchQuery].uiPages[CurrentPage] then
            LoadCatalogPage(CurrentPage)
        else
            local cache = CatalogCache[SearchQuery]
            CurrentPagesObject = cache.pages
            RenderCatalogEntries(cache.uiPages[CurrentPage], CurrentPage, cache.uiFinished[CurrentPage], SearchGeneration)
        end
    elseif favoritesActive then
        PageArea.Visible = false
        PrevPage.Visible = false
        NextPage.Visible = false
        RenderFavorites()
    elseif copyActive then
        PageArea.Visible = false
        PrevPage.Visible = false
        NextPage.Visible = false
        GridHolder.CanvasPosition = Vector2.zero
        RenderCopyPlayers()
    else
        PageArea.Visible = false
        PrevPage.Visible = false
        NextPage.Visible = false
        EmptyText.Visible = false
        GridHolder.CanvasPosition = Vector2.zero
    end
end

