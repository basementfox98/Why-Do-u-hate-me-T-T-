local Cards = {}

local function stop()
    if State.Track then
        pcall(function() State.Track:Stop(0.1) end)
        pcall(function() State.Track:Destroy() end)
        State.Track = nil
    end
end

local function playAnimation(id)
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    id = tostring(id):match("%d+")
    if not id then return end

    stop()

    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://"..id

    local ok,track = pcall(function()
        return humanoid:LoadAnimation(anim)
    end)

    if not ok or not track then
        anim:Destroy()
        return
    end

    track.Priority = Enum.AnimationPriority.Action
    track.Looped = true

    if pcall(function() track:Play(0.1,1,State.Speed) end) then
        State.Track = track
    else
        pcall(function() track:Destroy() end)
    end
end

local function filtered()
    local result = {}
    local q = string.lower(Search.Text or "")
    for _,e in ipairs(Emotes) do
        if q == "" or string.find(string.lower(e.name),q,1,true) then
            table.insert(result,e)
        end
    end
    return result
end

