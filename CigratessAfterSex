local function stopEmote()

    if State.CurrentTrack then

        pcall(function()

            State.CurrentTrack:
                Stop(0.15)

        end)

        State.CurrentTrack = nil

    end

end

local function playEmote(id)

    id = tonumber(id)

    if not id then
        return
    end

    local character =
        LocalPlayer.Character

    if not character then
        return
    end

    local humanoid =
        character:
            FindFirstChildOfClass(
                "Humanoid"
            )

    if not humanoid then
        return
    end

    stopEmote()

    local animation =
        Instance.new(
            "Animation"
        )

    animation.AnimationId =
        "rbxassetid://" ..
        tostring(id)

    local ok, track =
        pcall(function()

            return humanoid:
                LoadAnimation(
                    animation
                )

        end)

    animation:Destroy()

    if not ok or not track then
        return
    end

    pcall(function()

        track.Priority =
            Enum.AnimationPriority.Action4

        track.Looped = true

        track:Play(
            0.1,
            1,
            State.Speed
        )

    end)

    State.CurrentTrack =
        track

end

