local function loadGitHubImage(url)

    -- Executors that provide request + getcustomasset
    if typeof(request) == "function"
        and typeof(getcustomasset) == "function"
    then

        local ok, response = pcall(function()
            return request({
                Url = url,
                Method = "GET"
            })
        end)

        if ok
            and response
            and response.Body
        then

            local fileName =
                "SaikiEmotes_HideButton.jpg"

            local writeOK = pcall(function()

                if typeof(writefile) == "function" then
                    writefile(
                        fileName,
                        response.Body
                    )
                end

            end)

            if writeOK then

                local assetOK, asset =
                    pcall(function()

                        return getcustomasset(
                            fileName
                        )

                    end)

                if assetOK and asset then
                    return asset
                end

            end

        end

    end

    return ""

end

