local function GetThumbnail(id)
    -- Roblox's thumbnail protocol gives the actual Roblox asset cover
    -- rather than a generated placeholder.
    return "rbxthumb://type=Asset&id=" .. tostring(id) .. "&w=420&h=420"
end

local function ClearGrid()
    for _, child in ipairs(Grid:GetChildren()) do
        if child:IsA("GuiObject") and child ~= GridLayout then
            child:Destroy()
        end
    end
end

local function CreateCard(emote, layoutOrder)
    local card = New("Frame", {
        Name = "EmoteCard",
        Size = UDim2.fromOffset(105, 126),
        BackgroundColor3 = BLACK_2,
        BackgroundTransparency = 0.18,
        BorderSizePixel = 0,
        LayoutOrder = layoutOrder,
    }, Grid)

    AddCorner(card, 9)

    local cardStroke = AddStroke(
        card,
        Color3.fromRGB(74, 18, 28),
        1
    )

    -- Animated border is intentionally subtle on cards.
    local cardGradient = Instance.new("UIGradient")
    cardGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(10, 10, 12)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 35, 52)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(10, 10, 12)),
    })
    cardGradient.Rotation = 0
    cardGradient.Parent = cardStroke

    task.spawn(function()
        while card.Parent and cardGradient.Parent do
            local t = TweenService:Create(
                cardGradient,
                TweenInfo.new(3.4, Enum.EasingStyle.Linear),
                {Rotation = cardGradient.Rotation + 360}
            )
            t:Play()
            t.Completed:Wait()
        end
    end)

    local Cover = New("ImageButton", {
        Name = "Cover",
        Position = UDim2.fromOffset(4, 4),
        Size = UDim2.fromOffset(97, 89),
        BackgroundColor3 = PANEL_3,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Image = GetThumbnail(emote.id),
        ScaleType = Enum.ScaleType.Crop,
    }, card)

    AddCorner(Cover, 7)

    local CoverStroke = AddStroke(Cover, Color3.fromRGB(70, 19, 28), 1)

    local CoverOverlay = New("Frame", {
        Position = UDim2.new(0, 0, 1, -20),
        Size = UDim2.new(1, 0, 0, 20),
        BackgroundColor3 = BLACK,
        BackgroundTransparency = 0.18,
        BorderSizePixel = 0,
    }, Cover)

    AddCorner(CoverOverlay, 5)

    -- The name is the only text displayed on the card.
    local Name = New("TextLabel", {
        Position = UDim2.fromOffset(6, 96),
        Size = UDim2.new(1, -34, 0, 24),
        BackgroundTransparency = 1,
        Font = FONT_BOLD,
        Text = emote.name,
        TextSize = 9,
        TextWrapped = true,
        TextTruncate = Enum.TextTruncate.AtEnd,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextColor3 = WHITE,
    }, card)
    SetTextGradient(Name)

    local Favorite = New("TextButton", {
        Position = UDim2.new(1, -29, 1, -29),
        Size = UDim2.fromOffset(23, 23),
        BackgroundColor3 = PANEL_3,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Font = FONT_BOLD,
        Text = IsFavorite(emote.id) and "★" or "☆",
        TextSize = 17,
        TextColor3 = IsFavorite(emote.id) and THEME_RED or STAR_OFF,
    }, card)

    AddCorner(Favorite, 7)

    local FavStroke = AddStroke(
        Favorite,
        IsFavorite(emote.id) and THEME_RED or Color3.fromRGB(62, 34, 39),
        1
    )

    Favorite.MouseButton1Click:Connect(function()
        ToggleFavorite(emote.id)

        local active = IsFavorite(emote.id)

        Favorite.Text = active and "★" or "☆"
        Favorite.TextColor3 = active and THEME_RED or STAR_OFF
        FavStroke.Color = active and THEME_RED or Color3.fromRGB(62, 34, 39)

        if CurrentTab == "Favorites" then
            task.defer(function()
                RenderCurrentTab()
            end)
        end
    end)

    Cover.MouseButton1Click:Connect(function()
        PlayEmote(emote)
    end)
end

--//============================================================
--// FILTER / PAGINATION
--//============================================================

local function GetCurrentData()
    local query = string.lower(Search.Text or "")
    local source

    if CurrentTab == "Favorites" then
        source = GetFavoriteEmotes()
    else
        source = Emotes
    end

    local filtered = {}

    for _, emote in ipairs(source) do
        if query == "" or string.find(string.lower(emote.name), query, 1, true) then
            table.insert(filtered, emote)
        end
    end

    return filtered
end

function RenderCurrentTab()
    ClearGrid()

    local data = GetCurrentData()
    local totalPages = math.max(1, math.ceil(#data / PAGE_SIZE))

    if CurrentPage > totalPages then
        CurrentPage = totalPages
    end

    if CurrentPage < 1 then
        CurrentPage = 1
    end

    local first = ((CurrentPage - 1) * PAGE_SIZE) + 1
    local last = math.min(first + PAGE_SIZE - 1, #data)

    if #data == 0 then
        local Empty = New("TextLabel", {
            Size = UDim2.new(1, -10, 0, 100),
            BackgroundTransparency = 1,
            Font = FONT_BOLD,
            Text = (#Emotes == 0 and CurrentTab == "Emotes")
                and "The emote database could not be loaded."
                or (CurrentTab == "Favorites"
                    and "No favorite emotes yet."
                    or "No emotes found."),
            TextSize = 13,
            TextColor3 = MUTED,
            TextWrapped = true,
            LayoutOrder = 1,
        }, Grid)

        SetTextGradient(Empty)
    else
        local order = 0

        for index = first, last do
            order += 1
            CreateCard(data[index], order)
        end
    end

    PageLabel.Text = string.format("%d / %d", CurrentPage, totalPages)

    Grid.CanvasPosition = Vector2.new(0, 0)
end

