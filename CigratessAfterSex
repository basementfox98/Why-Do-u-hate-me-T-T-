local function getAnimator()
    local character = LocalPlayer.Character
    if not character then
        character = LocalPlayer.CharacterAdded:Wait()
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        humanoid = character:WaitForChild("Humanoid", 5)
    end

    if not humanoid then
        return nil
    end

    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        animator = make("Animator", {}, humanoid)
    end

    return animator
end

local function stopCurrent()
    if CurrentTrack then
        pcall(function()
            CurrentTrack:Stop(0.15)
            CurrentTrack:Destroy()
        end)
        CurrentTrack = nil
    end
end

local function playSelected()
    if not Selected then
        Status.Text = "Select an emote first."
        return
    end

    stopCurrent()

    local animator = getAnimator()
    if not animator then
        Status.Text = "Could not find your Animator."
        return
    end

    local animation = Instance.new("Animation")
    animation.AnimationId = safeAsset(Selected.id)

    local ok, track = pcall(function()
        return animator:LoadAnimation(animation)
    end)

    if not ok or not track then
        animation:Destroy()
        Status.Text = "This emote could not be loaded."
        warn("[Saiki Emotes V2] Animation load failed:", track)
        return
    end

    CurrentTrack = track
    track.Priority = Enum.AnimationPriority.Action4
    track.Looped = true

    local playOk, playErr = pcall(function()
        track:Play(0.15, 1, CurrentSpeed)
    end)

    animation:Destroy()

    if not playOk then
        CurrentTrack = nil
        pcall(function() track:Destroy() end)
        Status.Text = "This emote could not be played."
        warn("[Saiki Emotes V2] Play failed:", playErr)
        return
    end

    Status.Text = "Playing: " .. tostring(Selected.name)
end

local function setSpeed(value)
    CurrentSpeed = math.clamp(math.floor(value * 20 + 0.5) / 20, 0.25, 2.5)
    SpeedValue.Text = string.format("%.2fx", CurrentSpeed)

    local alpha = (CurrentSpeed - 0.25) / (2.5 - 0.25)
    SpeedFill.Size = UDim2.new(alpha, 0, 1, 0)

    if CurrentTrack then
        pcall(function()
            CurrentTrack:AdjustSpeed(CurrentSpeed)
        end)
    end
end

