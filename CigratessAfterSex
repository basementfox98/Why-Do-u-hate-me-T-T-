local function New(className, props, parent)
    local object = Instance.new(className)

    for property, value in pairs(props or {}) do
        object[property] = value
    end

    if parent then
        object.Parent = parent
    end

    return object
end

local function AddCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 8)
    corner.Parent = parent
    return corner
end

local function AddStroke(parent, color, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or DARK_RED
    stroke.Thickness = thickness or 1
    stroke.Parent = parent
    return stroke
end

local function AddTextGradient(label)
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, WHITE),
        ColorSequenceKeypoint.new(0.48, SOFT_WHITE),
        ColorSequenceKeypoint.new(1, THEME_RED),
    })
    gradient.Rotation = 0
    gradient.Parent = label
    return gradient
end

local function AddMovingBorder(parent, thickness)
    local stroke = AddStroke(parent, WHITE, thickness or 1.5)

    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, BLACK),
        ColorSequenceKeypoint.new(0.28, BRIGHT_RED),
        ColorSequenceKeypoint.new(0.50, BLACK),
        ColorSequenceKeypoint.new(0.72, BRIGHT_RED),
        ColorSequenceKeypoint.new(1, BLACK),
    })
    gradient.Rotation = 0
    gradient.Parent = stroke

    task.spawn(function()
        while stroke.Parent and gradient.Parent do
            local tween = TweenService:Create(
                gradient,
                TweenInfo.new(2.8, Enum.EasingStyle.Linear),
                {Rotation = gradient.Rotation + 360}
            )
            tween:Play()
            tween.Completed:Wait()
        end
    end)

    return stroke
end

local function SetTextGradient(label)
    if not label:FindFirstChildOfClass("UIGradient") then
        AddTextGradient(label)
    end
end

local function SafeCall(fn, ...)
    local ok, result = pcall(fn, ...)
    if ok then
        return result
    end
    return nil
end

