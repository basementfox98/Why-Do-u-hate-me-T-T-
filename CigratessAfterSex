local function renderItems(items, pageNumber, hasNext, hasPrev)
    RenderId += 1
    local thisRender = RenderId
    clearCards()
    State.Selected = nil
    Emotes = {}

    if type(items) ~= "table" or #items == 0 then
        StatusLabel.Text = "No emotes found"
        PageLabel.Text = "Page " .. tostring(pageNumber)
        return
    end

    for _,item in ipairs(items) do
        local id = tonumber(item.id or item.Id or item.assetId or item.AssetId)
        local name = item.name or item.Name or ("Emote " .. tostring(id or ""))
        if id then
            table.insert(Emotes,{id=tostring(id),name=tostring(name)})
        end
    end

    StatusLabel.Text = tostring(#Emotes) .. " emotes • Roblox Store"
    PageLabel.Text = "Page " .. tostring(pageNumber)

    task.spawn(function()
        for i,e in ipairs(Emotes) do
            if thisRender ~= RenderId then return end
            local card = getCard(i)
            card.Visible = true
            card.LayoutOrder = i
            card.BackgroundColor3 = C().Button
            local img = card:FindFirstChild("Image")
            local nameLabel = card:FindFirstChild("Name")
            local idLabel = card:FindFirstChild("Id")
            local playButton = card:FindFirstChild("Play")
            img.Image = "rbxthumb://type=Asset&id=" .. e.id .. "&w=150&h=150"
            nameLabel.Text = e.name
            idLabel.Text = "ID: " .. e.id
            if playButton:GetAttribute("Bound") ~= true then
                playButton:SetAttribute("Bound",true)
                playButton.MouseButton1Click:Connect(function()
                    local selectedId = playButton:GetAttribute("EmoteId")
                    local selectedName = playButton:GetAttribute("EmoteName")
                    if not selectedId then return end
                    State.Selected = {id=selectedId,name=selectedName}
                    PTitle.Text = selectedName
                    PSub.Text = "Animation ID: " .. selectedId
                    Cover.Image = "rbxthumb://type=Asset&id=" .. selectedId .. "&w=300&h=300"
                    playAnimation(selectedId)
                end)
            end
            playButton:SetAttribute("EmoteId",e.id)
            playButton:SetAttribute("EmoteName",e.name)
            if i % 3 == 0 then RunService.RenderStepped:Wait() end
        end
    end

    Prev.Active = hasPrev == true
    Next.Active = hasNext == true
end

local function getCatalogPage(keyword)
    local params
    local ok = pcall(function()
        params = CatalogSearchParams.new()
        params.SearchKeyword = keyword or ""
        params.CategoryFilter = Enum.CatalogCategoryFilter.None
        params.SalesTypeFilter = Enum.SalesTypeFilter.All
        params.AssetTypes = {Enum.AvatarAssetType.EmoteAnimation}
        params.IncludeOffSale = true
        params.SortType = Enum.CatalogSortType.Relevance
        params.Limit = PAGE_SIZE
    end)
    if not ok or not params then return nil end

    local callOk,result = pcall(function()
        if AvatarEditorService.SearchCatalogAsync then
            return AvatarEditorService:SearchCatalogAsync(params)
        end
        return AvatarEditorService:SearchCatalog(params)
    end)
    if not callOk then
        callOk,result = pcall(function()
            return AvatarEditorService:SearchCatalog(params)
        end)
    end
    if callOk then return result end
    return nil
end

local function httpGet(url)
    local ok,res = false,nil
    if HttpRequest then
        ok,res = pcall(function() return HttpRequest({Url=url,Method="GET"}) end)
        if ok and res then
            local body = res.Body
            if type(body) == "string" and #body > 20 then return body end
        end
    end
    ok,res = pcall(function() return game:HttpGet(url) end)
    if ok and type(res) == "string" and #res > 20 then return res end
    return nil
end

local function loadHttpStore(keyword,cursor,direction)
    local url = "https://catalog.roblox.com/v1/search/items/details?Category=12&Subcategory=39&SortType=0&SortAggregation=5&Limit=10"
    if keyword and keyword ~= "" then
        url = url .. "&Keyword=" .. HttpService:UrlEncode(keyword)
    end
    if cursor and cursor ~= "" then
        url = url .. "&Cursor=" .. HttpService:UrlEncode(cursor)
    end

    local raw = httpGet(url)
    if not raw then return nil end
    local ok,data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not ok or type(data) ~= "table" or type(data.data) ~= "table" then return nil end

    return {
        data = data.data,
        nextCursor = data.nextPageCursor,
        previousCursor = data.previousPageCursor
    }
end

local function loadFirstPage(keyword)
    CatalogRequestId += 1
    local requestId = CatalogRequestId
    CatalogLoading = true
    CurrentKeyword = keyword or ""
    HttpCursor = nil
    HttpPrevCursors = {}
    HttpMode = false
    StatusLabel.Text = "Loading Roblox Store..."
    PageLabel.Text = "Loading..."
    Prev.Active = false
    Next.Active = false
    clearCards()

    task.spawn(function()
        local result = getCatalogPage(CurrentKeyword)
        if requestId ~= CatalogRequestId then return end

        if result then
            CatalogPage = result
            CatalogLoading = false
            local ok,current = pcall(function() return result:GetCurrentPage() end)
            if ok and type(current) == "table" then
                local hasNext = not result.IsFinished
                renderItems(current,1,hasNext,false)
                print("[Saiki Emotes] Loaded " .. tostring(#current) .. " catalog emotes via AvatarEditorService.")
                return
            end
        end

        -- Fallback: direct Roblox Marketplace API. This is still the public Store,
        -- not inventory data.
        HttpMode = true
        local page = loadHttpStore(CurrentKeyword,nil,"first")
        CatalogLoading = false
        if page then
            HttpCursor = page.nextCursor
            renderItems(page.data,1,page.nextCursor ~= nil,false)
            print("[Saiki Emotes] Loaded catalog emotes through Roblox Marketplace API fallback.")
        else
            StatusLabel.Text = "Store unavailable"
            PageLabel.Text = "Page 1"
            warn("[Saiki Emotes] Both AvatarEditorService and Roblox Marketplace API failed.")
        end
    end)
end

local function nextCatalogPage()
    if CatalogLoading then return end
    if HttpMode then
        if not HttpCursor then return end
        CatalogLoading = true
        local page = loadHttpStore(CurrentKeyword,HttpCursor,"next")
        CatalogLoading = false
        if page then
            table.insert(HttpPrevCursors,HttpCursor)
            HttpCursor = page.nextCursor
            State.Page += 1
            renderItems(page.data,State.Page,page.nextCursor ~= nil,true)
        end
        return
    end

    if not CatalogPage or CatalogPage.IsFinished then return end
    CatalogLoading = true
    Prev.Active = false
    Next.Active = false
    local ok = pcall(function() CatalogPage:AdvanceToNextPageAsync() end)
    CatalogLoading = false
    if ok then
        State.Page += 1
        local got,current = pcall(function() return CatalogPage:GetCurrentPage() end)
        if got then renderItems(current,State.Page,not CatalogPage.IsFinished,true) end
    else
        StatusLabel.Text = "Could not load page"
        Next.Active = true
    end
end

local function previousCatalogPage()
    if CatalogLoading or State.Page <= 1 then return end
    if HttpMode then
        local cursor = table.remove(HttpPrevCursors)
        if not cursor then return end
        CatalogLoading = true
        local page = loadHttpStore(CurrentKeyword,cursor,"previous")
        CatalogLoading = false
        if page then
            HttpCursor = page.nextCursor
            State.Page -= 1
            renderItems(page.data,State.Page,page.nextCursor ~= nil,State.Page > 1)
        end
        return
    end
    -- AvatarEditorService CatalogPages is forward-only in the normal flow.
    -- Re-run the search to rebuild the requested previous page without inventory access.
    local target = State.Page - 1
    loadFirstPage(CurrentKeyword)
    if target > 1 then
        task.spawn(function()
            for _=2,target do
                repeat task.wait() until not CatalogLoading
                if CatalogPage and not CatalogPage.IsFinished then nextCatalogPage() end
            end
        end)
    end
end

local function loadCatalog(keyword)
    State.Page = 1
    loadFirstPage(keyword or "")
end

