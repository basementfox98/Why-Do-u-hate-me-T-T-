--==================================================
-- EMOTE PLAYER
--==================================================

local function GetAnimator()
    local character = Player.Character or Player.CharacterAdded:Wait()
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        return nil, nil
    end

    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end

    return animator, humanoid
end

local function StopAllTracks()
    local animator = GetAnimator()
    if not animator then return end

    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        pcall(function()
            track:Stop(0.12)
        end)
    end
end

local function StopEmote()
    if HudConnection then
        HudConnection:Disconnect()
        HudConnection = nil
    end

    if CurrentTrack then
        pcall(function()
            CurrentTrack:Stop(0.12)
            CurrentTrack:Destroy()
        end)
    end

    CurrentTrack = nil

    if CurrentAnimation then
        CurrentAnimation:Destroy()
        CurrentAnimation = nil
    end

    CurrentEmote = nil
    Hud.Visible = false
end

local function ApplySpeed()
    if CurrentTrack then
        pcall(function()
            CurrentTrack:AdjustSpeed(Settings.speed)
        end)
    end
end

local function PlayEmote(emote)
    local animator = GetAnimator()
    if not animator then
        return
    end

    StopEmote()
    StopAllTracks()

    local animation = Instance.new("Animation")
    animation.AnimationId = "rbxassetid://" .. tostring(emote.id)
    CurrentAnimation = animation

    local ok, track = pcall(function()
        return animator:LoadAnimation(animation)
    end)

    if not ok or not track then
        animation:Destroy()
        CurrentAnimation = nil
        return
    end

    CurrentTrack = track
    CurrentEmote = emote

    track.Priority = Enum.AnimationPriority.Action
    track.Looped = Settings.loop

    local played = pcall(function()
        track:Play(0.12)
        track:AdjustSpeed(Settings.speed)
    end)

    if not played then
        StopEmote()
        return
    end

    if Settings.showHUD then
        Hud.Visible = true
    end

    if HudConnection then
        HudConnection:Disconnect()
    end

    HudConnection = RunService.Heartbeat:Connect(function()
        if not CurrentTrack or CurrentTrack ~= track then
            return
        end

        if not track.IsPlaying then
            StopEmote()
            return
        end

        if Settings.stopOnMovement then
            local _, humanoid = GetAnimator()
            if humanoid and humanoid.MoveDirection.Magnitude > 0.05 then
                StopEmote()
                return
            end
        end

        -- HUD is deliberately updated only once per frame while an emote
        -- is active. There are no tab-specific RenderStepped loops.
        if Hud.Visible then
            local length = track.Length
            local position = track.TimePosition

            if length and length > 0 then
                Progress.Size = UDim2.new(
                    math.clamp(position / length, 0, 1),
                    0, 1, 0
                )
                TimeLabel.Text = string.format(
                    "%0.1f / %0.1f",
                    position,
                    length
                )
            else
                Progress.Size = UDim2.new(0, 0, 1, 0)
                TimeLabel.Text = "Playing"
            end

            SpeedLabel.Text = string.format("Speed %.1fx", Settings.speed)
            EmoteName.Text = emote.name
        end
    end)
end

