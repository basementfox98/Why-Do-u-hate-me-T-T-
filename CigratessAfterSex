local function stop()
    if State.Track then
        pcall(function() State.Track:Stop(0.1) end)
        pcall(function() State.Track:Destroy() end)
        State.Track = nil
    end
end

local function playAnimation(id)
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    id = tostring(id):match("%d+")
    if not id then return end
    stop()

    local animationId = "rbxassetid://" .. id
    pcall(function()
        local objects = game:GetObjects(animationId)
        if objects and #objects > 0 then
            local obj = objects[1]
            local animation = obj:IsA("Animation") and obj or obj:FindFirstChildWhichIsA("Animation", true)
            if animation and animation.AnimationId ~= "" then
                animationId = animation.AnimationId
            end
        end
    end)

    local anim = Instance.new("Animation")
    anim.AnimationId = animationId
    local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator")
    if not animator.Parent then animator.Parent = humanoid end

    local ok, track = pcall(function()
        return animator:LoadAnimation(anim)
    end)
    if not ok or not track then
        anim:Destroy()
        return
    end

    track.Priority = Enum.AnimationPriority.Action4
    track.Looped = true
    local played = pcall(function() track:Play(0.1, 1, State.Speed) end)
    anim:Destroy()
    if played then State.Track = track else pcall(function() track:Destroy() end) end
end

