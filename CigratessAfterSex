local function LoadFavorites()
    Favorites = {}
    FavoritesSet = {}

    local ok, data = pcall(function()
        if readfile and isfile and isfile(SAVE_FILE) then
            return HttpService:JSONDecode(readfile(SAVE_FILE))
        end
        return {}
    end)

    if not ok or type(data) ~= "table" then return end

    for _, id in ipairs(data) do
        id = tonumber(id)
        if id and not FavoritesSet[id] then
            FavoritesSet[id] = true
            table.insert(Favorites, id)
        end
    end
end

local function SaveFavorites()
    pcall(function()
        if writefile then
            writefile(SAVE_FILE, HttpService:JSONEncode(Favorites))
        end
    end)
end

LoadFavorites()

local function LoadSettings()
    pcall(function()
        if readfile and isfile and isfile(SETTINGS_FILE) then
            local data = HttpService:JSONDecode(readfile(SETTINGS_FILE))
            if type(data) == "table" then
                if tonumber(data.Speed) then Settings.Speed = math.clamp(tonumber(data.Speed), 0.25, 3) end
                if data.Looped ~= nil then Settings.Looped = data.Looped == true end
                if data.StopOnMovement ~= nil then Settings.StopOnMovement = data.StopOnMovement == true end
                if data.Notifications ~= nil then Settings.Notifications = data.Notifications == true end
                if data.CopyEmoteEnabled ~= nil then Settings.CopyEmoteEnabled = data.CopyEmoteEnabled == true end
                if type(data.Theme) == "string" and ThemeDefinitions[data.Theme] then Settings.Theme = data.Theme end
            end
        end
    end)
end
local function SaveSettings()
    pcall(function()
        if writefile then writefile(SETTINGS_FILE, HttpService:JSONEncode(Settings)) end
    end)
end
LoadSettings()
SetThemeColors(Settings.Theme)

local function IsFavorite(id)
    return FavoritesSet[id] == true
end

local function ToggleFavorite(id)
    id = tonumber(id)
    if not id then return end

    if IsFavorite(id) then
        FavoritesSet[id] = nil
        for i, value in ipairs(Favorites) do
            if value == id then
                table.remove(Favorites, i)
                break
            end
        end
    else
        FavoritesSet[id] = true
        table.insert(Favorites, id)
    end

    SaveFavorites()
end

local ThemeTransitionToken = 0
local BuildAmbientForTheme -- forward declaration so theme changes can rebuild effects immediately

local function ApplyTheme(name, animated)
    local newTheme = ThemeDefinitions[name] or ThemeDefinitions.Blood
    ThemeTransitionToken = ThemeTransitionToken + 1
    local token = ThemeTransitionToken

    SetThemeColors(name)

    -- Rebuild ambient immediately when the theme changes. This guarantees the
    -- previous theme's particles are destroyed before the new effect starts.
    if BuildAmbientForTheme then
        BuildAmbientForTheme()
    end

    local duration = animated and 0.28 or 0

    for _, item in ipairs(ThemeObjects) do
        if item.object and item.object.Parent then
            local target = newTheme[item.role]
            if target then
                if animated and typeof(item.object[item.property]) == "Color3" then
                    TweenService:Create(item.object, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {[item.property] = target}):Play()
                else
                    item.object[item.property] = target
                end
            end
        end
    end

    for _, item in ipairs(ThemeStrokes) do
        if item.object and item.object.Parent then
            local target = newTheme[item.role]
            if target then
                if animated then
                    TweenService:Create(item.object, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Color = target}):Play()
                else
                    item.object.Color = target
                end
            end
        end
    end

    if animated then
        task.delay(duration, function()
            if token == ThemeTransitionToken then
                ApplyTheme(name, false)
            end
        end)
        return
    end

    local isAurora = CurrentThemeName == "Aurora"
    for _, g in ipairs(ThemeTextGradients) do
        if g and g.Parent then
            if isAurora then
                g.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, newTheme.WHITE),
                    ColorSequenceKeypoint.new(0.28, newTheme.WHITE),
                    ColorSequenceKeypoint.new(0.58, newTheme.ACCENT),
                    ColorSequenceKeypoint.new(0.78, newTheme.BRIGHT),
                    ColorSequenceKeypoint.new(1, newTheme.WHITE),
                })
            else
                g.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, newTheme.WHITE),
                    ColorSequenceKeypoint.new(0.52, newTheme.SOFT),
                    ColorSequenceKeypoint.new(1, newTheme.ACCENT),
                })
                g.Offset = Vector2.zero
            end
        end
    end

    for _, g in ipairs(ThemeBorderGradients) do
        if g and g.Parent then
            if isAurora then
                g.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, newTheme.WHITE),
                    ColorSequenceKeypoint.new(0.24, newTheme.ACCENT),
                    ColorSequenceKeypoint.new(0.50, newTheme.WHITE),
                    ColorSequenceKeypoint.new(0.76, newTheme.BRIGHT),
                    ColorSequenceKeypoint.new(1, newTheme.WHITE),
                })
            else
                g.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, newTheme.DARK),
                    ColorSequenceKeypoint.new(0.32, newTheme.ACCENT),
                    ColorSequenceKeypoint.new(0.50, newTheme.BRIGHT),
                    ColorSequenceKeypoint.new(0.68, newTheme.ACCENT),
                    ColorSequenceKeypoint.new(1, newTheme.DARK),
                })
                g.Offset = Vector2.zero
            end
        end
    end

    if BuildAmbientForTheme then BuildAmbientForTheme() end
end

-- Subtle animated gradient for Aurora. One lightweight loop drives the registered gradients.
task.spawn(function()
    while true do
        task.wait(0.045)
        if CurrentThemeName == "Aurora" then
            local offset = (os.clock() * 0.12) % 2 - 1
            for _, g in ipairs(ThemeTextGradients) do
                if g and g.Parent then g.Offset = Vector2.new(offset, 0) end
            end
            for _, g in ipairs(ThemeBorderGradients) do
                if g and g.Parent then g.Offset = Vector2.new(-offset * 0.65, 0) end
            end
        else
            for _, g in ipairs(ThemeTextGradients) do
                if g and g.Parent and g.Offset ~= Vector2.zero then g.Offset = Vector2.zero end
            end
            for _, g in ipairs(ThemeBorderGradients) do
                if g and g.Parent and g.Offset ~= Vector2.zero then g.Offset = Vector2.zero end
            end
        end
    end
end)

