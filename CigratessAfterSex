--============================================================
-- EMOTE PLAYBACK
--============================================================

local function GetAnimator()
    local character = Player.Character or Player.CharacterAdded:Wait()
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return nil, nil end

    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end
    return animator, humanoid
end

local function StopEmote()
    if TrackConnection then
        TrackConnection:Disconnect()
        TrackConnection = nil
    end

    if CurrentTrack then
        pcall(function() CurrentTrack:Stop(0.12) end)
    end
    CurrentTrack = nil

    if CurrentAnimation then
        -- Only destroy Animation instances created by Saiki itself.
        if CurrentAnimation.Name == "SaikiPlayingEmote" or string.sub(CurrentAnimation.Name, 1, 12) == "SaikiEmote_" then
            pcall(function() CurrentAnimation:Destroy() end)
        end
        CurrentAnimation = nil
    end

    CurrentEmote = nil
    Hud.Visible = false
    Pause.Text = "II"
end

local AnimationCache = {}

local function ResolveEmoteAnimation(assetId)
    local key = tostring(assetId)
    if AnimationCache[key] then
        return AnimationCache[key]
    end

    -- Catalog emote IDs are not always directly usable as AnimationIds.
    -- Resolve the catalog asset first, then use the Animation object it contains.
    local ok, objects = pcall(function()
        return game:GetObjects("rbxassetid://" .. key)
    end)

    if ok and objects and #objects > 0 then
        local found

        local function scan(instance)
            if found then return end

            if instance:IsA("Animation") then
                found = instance
                return
            end

            for _, child in ipairs(instance:GetChildren()) do
                scan(child)
                if found then return end
            end
        end

        for _, object in ipairs(objects) do
            scan(object)
            if found then break end
        end

        if found then
            AnimationCache[key] = found
            return found
        end
    end

    -- Fallback for assets that can be loaded directly as animations.
    local fallback = Instance.new("Animation")
    fallback.Name = "SaikiEmote_" .. key
    fallback.AnimationId = "rbxassetid://" .. key
    AnimationCache[key] = fallback
    return fallback
end

local function PlayEmote(emote)
    if not emote or not emote.id then return end

    task.spawn(function()
        local animator = GetAnimator()
        if not animator then return end

        StopEmote()

        local resolvedAnimation = ResolveEmoteAnimation(emote.id)
        if not resolvedAnimation then return end

        -- Never use the cached Animation instance directly because StopEmote()
        -- destroys CurrentAnimation. Clone it so the cached catalog animation
        -- remains available for the next click.
        local animation = resolvedAnimation:Clone()
        animation.Name = "SaikiPlayingEmote"
        CurrentAnimation = animation

        local ok, track = pcall(function()
            return animator:LoadAnimation(animation)
        end)

        if not ok or not track then
            StopEmote()
            return
        end

        CurrentEmote = emote
        CurrentTrack = track
        track.Priority = Enum.AnimationPriority.Action4
        track.Looped = Settings.Looped

        local played = pcall(function()
            track:Play(0.1, 1, Settings.Speed)
        end)

        if not played then
            StopEmote()
            return
        end

        HudName.Text = emote.name
        HudSpeed.Text = string.format("%.2fx", Settings.Speed)
        Hud.Visible = true

        if Settings.Notifications then
            pcall(function()
                game:GetService("StarterGui"):SetCore("SendNotification", {Title = "Saiki Emotes", Text = "Playing: " .. tostring(emote.name), Duration = 2})
            end)
        end

        TrackConnection = RunService.Heartbeat:Connect(function()
            if not CurrentTrack or CurrentTrack ~= track then return end

            if not track.IsPlaying then
                StopEmote()
                return
            end

            if Settings.StopOnMovement then
                local _, humanoid = GetAnimator()
                if humanoid and humanoid.MoveDirection.Magnitude > 0.05 then
                    StopEmote()
                    return
                end
            end
        end)
    end)
end

--============================================================
-- COPY EMOTE (INFINITE YIELD / VEX-STYLE)
--============================================================
-- Copies the target player's actual currently-playing AnimationTrack.
-- This preserves the animation, speed, and current time position instead
-- of trying to interpret the animation as a Roblox catalog emote ID.

local COPY_PROMPT_TAG = "SaikiCopyEmotePrompt"
local CopyConnections = {}

CopyPlayingAnimationFrom = function(targetCharacter)
    if not targetCharacter or targetCharacter == Player.Character then return false end

    local targetHumanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
    local myCharacter = Player.Character
    local myHumanoid = myCharacter and myCharacter:FindFirstChildOfClass("Humanoid")
    if not targetHumanoid or not myHumanoid then return false end

    local targetAnimator = targetHumanoid:FindFirstChildOfClass("Animator")
    local myAnimator = myHumanoid:FindFirstChildOfClass("Animator")
    if not targetAnimator or not myAnimator then return false end

    local targetTracks = targetAnimator:GetPlayingAnimationTracks()

    -- Match Infinite Yield's behavior: copy the first non-default animation.
    for _, targetTrack in ipairs(targetTracks) do
        local animation = targetTrack.Animation
        local animationId = animation and tostring(animation.AnimationId or "") or ""

        if animation and animationId ~= "" and not string.find(animationId, "507768375", 1, true) then
            -- Stop our current emote first.
            StopEmote()

            local ok, copiedTrack = pcall(function()
                return myAnimator:LoadAnimation(animation)
            end)

            if not ok or not copiedTrack then
                return false
            end

            copiedTrack.Priority = Enum.AnimationPriority.Action4
            copiedTrack.Looped = targetTrack.Looped

            local speed = tonumber(targetTrack.Speed) or 1
            local timePosition = tonumber(targetTrack.TimePosition) or 0

            local played = pcall(function()
                copiedTrack:Play(0.1, 1, speed)
                if copiedTrack.Length > 0 then
                    copiedTrack.TimePosition = math.clamp(timePosition, 0, copiedTrack.Length)
                else
                    copiedTrack.TimePosition = timePosition
                end
            end)

            if not played then
                pcall(function() copiedTrack:Stop() end)
                pcall(function() copiedTrack:Destroy() end)
                return false
            end

            CurrentTrack = copiedTrack
            CurrentAnimation = animation
            CurrentEmote = {
                id = AssetId(animationId),
                name = "Copied Emote",
            }

            HudName.Text = "Copied Emote"
            HudSpeed.Text = string.format("%.2fx", speed)
            Hud.Visible = true

            if Settings.Notifications then
                pcall(function()
                    game:GetService("StarterGui"):SetCore("SendNotification", {
                        Title = "Saiki Emotes",
                        Text = "Copied emote from " .. tostring(targetCharacter.Name),
                        Duration = 2,
                    })
                end)
            end

            -- Keep the copied animation synchronized with the source track.
            TrackConnection = RunService.Heartbeat:Connect(function()
                if CurrentTrack ~= copiedTrack then return end

                if not targetTrack.IsPlaying then
                    StopEmote()
                    return
                end

                if not copiedTrack.IsPlaying then
                    StopEmote()
                    return
                end

                -- Infinite Yield starts the copied track at the target's
                -- speed/time. Keep speed in sync if the source changes it.
                pcall(function()
                    copiedTrack:AdjustSpeed(targetTrack.Speed)
                end)
            end)

            return true
        end
    end

    return false
end

local function CopyPromptForCharacter(targetCharacter)
    if not targetCharacter or targetCharacter == Player.Character then return end
    local root = targetCharacter:FindFirstChild("HumanoidRootPart")
    if not root or root:FindFirstChild(COPY_PROMPT_TAG) then return end

    local prompt = Instance.new("ProximityPrompt")
    prompt.Name = COPY_PROMPT_TAG
    prompt.ActionText = "Copy Emote"
    prompt.ObjectText = targetCharacter.Name
    prompt.MaxActivationDistance = 10
    prompt.HoldDuration = 0
    prompt.RequiresLineOfSight = false
    prompt.KeyboardKeyCode = Enum.KeyCode.E
    prompt.Parent = root

    prompt.Triggered:Connect(function(triggeringPlayer)
        if triggeringPlayer and triggeringPlayer ~= Player then return end
        local copied = CopyPlayingAnimationFrom(targetCharacter)
        if not copied and Settings.Notifications then
            pcall(function()
                game:GetService("StarterGui"):SetCore("SendNotification", {
                    Title = "Saiki Emotes",
                    Text = "That player is not playing a copyable emote.",
                    Duration = 2,
                })
            end)
        end
    end)
end

DisableCopyEmotePrompts = function()
    for _, connection in ipairs(CopyConnections) do
        pcall(function() connection:Disconnect() end)
    end
    CopyConnections = {}

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player and p.Character then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local prompt = root:FindFirstChild(COPY_PROMPT_TAG)
                if prompt then prompt:Destroy() end
            end
        end
    end
end

EnableCopyEmotePrompts = function()
    DisableCopyEmotePrompts()

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player then
            if p.Character then
                task.spawn(function()
                    CopyPromptForCharacter(p.Character)
                end)
            end

            table.insert(CopyConnections, p.CharacterAdded:Connect(function(character)
                if Settings.CopyEmoteEnabled then
                    task.wait(0.25)
                    CopyPromptForCharacter(character)
                end
            end))
        end
    end

    table.insert(CopyConnections, Players.PlayerAdded:Connect(function(p)
        table.insert(CopyConnections, p.CharacterAdded:Connect(function(character)
            if Settings.CopyEmoteEnabled then
                task.wait(0.25)
                CopyPromptForCharacter(character)
            end
        end))
    end))
end

