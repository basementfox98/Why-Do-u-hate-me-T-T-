-- Load the requested GitHub image.
-- Roblox ImageLabels cannot directly display a normal GitHub URL, so the
-- executor downloads the file first and then converts it to a local asset.
task.spawn(function()
    if not HttpRequest or not GetCustomAsset or not writefile then
        warn("[Saiki Emotes] Executor does not provide HTTP/local-asset functions; hide image cannot be downloaded.")
        return
    end

    local url = "https://raw.githubusercontent.com/SaikiWithTheBanHammer/ScriptBlox/main/AuraFarmerSaiki.jpg"
    local file = "Saiki_AuraFarmer_Hide.jpg"

    local ok, response = pcall(function()
        return HttpRequest({
            Url = url,
            Method = "GET"
        })
    end)

    if not ok or not response then
        warn("[Saiki Emotes] GitHub image request failed.")
        return
    end

    local body = response.Body
    if type(body) ~= "string" or #body < 100 then
        warn("[Saiki Emotes] GitHub returned an empty/invalid image.")
        return
    end

    local wrote = pcall(function()
        writefile(file, body)
    end)

    if not wrote then
        warn("[Saiki Emotes] Could not save the GitHub image locally.")
        return
    end

    local assetOK, asset = pcall(function()
        return GetCustomAsset(file)
    end)

    if assetOK and asset then
        HideButton.Image = asset
        print("[Saiki Emotes] GitHub hide image loaded.")
    else
        warn("[Saiki Emotes] Could not convert the downloaded image to a Roblox asset.")
    end
end)

