--==============================================================
-- MOVEMENT HANDLER
-- IMPORTANT: does NOTHING unless StopWhenMoving is enabled.
--==============================================================
RunService.RenderStepped:Connect(function()
    if not Settings.StopWhenMoving then return end

    local humanoid = getHumanoid()
    local track = State.CurrentTrack
    if not humanoid or not track or not track.IsPlaying then return end

    local state = humanoid:GetState()
    if humanoid.MoveDirection.Magnitude > 0.05
        or state == Enum.HumanoidStateType.Jumping
        or state == Enum.HumanoidStateType.Freefall then

        pcall(function()
            track:Stop(Settings.FadeOut)
        end)

        if State.CurrentTrack == track then
            State.CurrentTrack = nil
            State.Paused = false
            PlaybackHUD.Visible = false
        end
    end
end)

