local function addSettingNumber(name, key, min, max, step)
    local row = create("Frame", {
        Size = UDim2.new(1,-6,0,48),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        BorderSizePixel = 0,
    }, SettingsFrame)
    corner(row,9)
    stroke(row,Color3.fromRGB(220,205,230),1,0.18)

    local label = create("TextLabel", {
        Size = UDim2.new(0.45,0,0,22),
        Position = UDim2.fromOffset(10,2),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = Color3.fromRGB(65,55,75),
        Font = Enum.Font.GothamMedium,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local valueBox = create("TextBox", {
        Size = UDim2.fromOffset(70,24),
        Position = UDim2.new(1,-80,0,2),
        BackgroundColor3 = Color3.fromRGB(249,245,252),
        BorderSizePixel = 0,
        Text = tostring(Settings[key]),
        TextColor3 = Color3.fromRGB(65,55,75),
        Font = Enum.Font.Gotham,
        TextSize = 10,
        ClearTextOnFocus = false,
        TextXAlignment = Enum.TextXAlignment.Center,
    }, row)
    corner(valueBox,7)
    stroke(valueBox,Color3.fromRGB(220,205,230),1,0.2)

    local bar = create("Frame", {
        Size = UDim2.new(1,-20,0,8),
        Position = UDim2.fromOffset(10,33),
        BackgroundColor3 = Color3.fromRGB(235,228,240),
        BorderSizePixel = 0,
    }, row)
    corner(bar,5)

    local fill = create("Frame", {
        Size = UDim2.fromScale(0,1),
        BackgroundColor3 = Color3.fromRGB(225,105,164),
        BorderSizePixel = 0,
    }, bar)
    corner(fill,5)

    local function apply(v)
        v = math.clamp(v,min,max)
        if step and step > 0 then
            v = math.floor(v/step + 0.5) * step
        end
        Settings[key] = v
        valueBox.Text = string.format("%.2f",v)
        fill.Size = UDim2.fromScale((v-min)/(max-min),1)

        if State.CurrentTrack and State.CurrentTrack.IsPlaying then
            pcall(function()
                if key == "Speed" then State.CurrentTrack:AdjustSpeed(v) end
                if key == "Weight" then State.CurrentTrack:AdjustWeight(math.max(0.001,v)) end
                if key == "TimePosition" and State.CurrentTrack.Length > 0 then
                    State.CurrentTrack.TimePosition = v * State.CurrentTrack.Length
                end
            end)
        end
    end

    local draggingBar = false

    local function fromInput(input)
        local x = math.clamp(
            (input.Position.X - bar.AbsolutePosition.X) /
            math.max(1,bar.AbsoluteSize.X),
            0,1
        )
        apply(min + (max-min)*x)
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            draggingBar = true
            fromInput(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if draggingBar and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            fromInput(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            draggingBar = false
        end
    end)

    valueBox.FocusLost:Connect(function(enter)
        if not enter then
            valueBox.Text = string.format("%.2f",Settings[key])
            return
        end
        local n = tonumber(valueBox.Text)
        if n then apply(n) else valueBox.Text = string.format("%.2f",Settings[key]) end
    end)

    apply(Settings[key])
end

