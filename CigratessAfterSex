local function normalizeCatalogPage(page)
    local out = {}

    if type(page) ~= "table" then
        return out
    end

    for _, item in ipairs(page) do
        local id = tonumber(item.Id or item.id)
        local name = item.Name or item.name

        if id and name then
            table.insert(out, {
                name = tostring(name),
                id = id
            })
        end
    end

    return out
end

local function searchWithAvatarEditor(keyword)
    local okService, service = pcall(function()
        return game:GetService("AvatarEditorService")
    end)

    if not okService or not service then
        return nil
    end

    local okParams, params = pcall(function()
        return CatalogSearchParams.new()
    end)

    if not okParams or not params then
        return nil
    end

    pcall(function()
        params.SearchKeyword = keyword or ""
        params.CategoryFilter = Enum.CatalogCategoryFilter.None
        params.SalesTypeFilter = Enum.SalesTypeFilter.All
        params.AssetTypes = {Enum.AvatarAssetType.EmoteAnimation}
        params.IncludeOffSale = true
        params.SortType = Enum.CatalogSortType.Relevance
        params.Limit = 10
    end)

    local okSearch, pages = pcall(function()
        return service:SearchCatalogAsync(params)
    end)

    if not okSearch or not pages then
        return nil
    end

    local okPage, page = pcall(function()
        return pages:GetCurrentPage()
    end)

    if not okPage then
        return nil
    end

    return normalizeCatalogPage(page)
end

local function getHttpFunction()
    if type(request) == "function" then
        return function(url)
            local response = request({
                Url = url,
                Method = "GET"
            })

            if response and tonumber(response.StatusCode) == 200 then
                return response.Body
            end

            return nil
        end
    end

    if type(http_request) == "function" then
        return function(url)
            local response = http_request({
                Url = url,
                Method = "GET"
            })

            if response and tonumber(response.StatusCode) == 200 then
                return response.Body
            end

            return nil
        end
    end

    if type(syn) == "table" and type(syn.request) == "function" then
        return function(url)
            local response = syn.request({
                Url = url,
                Method = "GET"
            })

            if response and tonumber(response.StatusCode) == 200 then
                return response.Body
            end

            return nil
        end
    end

    if type(game.HttpGet) == "function" then
        return function(url)
            local ok, body = pcall(function()
                return game:HttpGet(url)
            end)

            if ok then
                return body
            end

            return nil
        end
    end

    return nil
end

local function searchWithHttp(keyword, page)
    local http = getHttpFunction()
    if not http then
        return nil
    end

    local encoded = ""
    pcall(function()
        encoded = HttpService:UrlEncode(keyword or "")
    end)

    local url =
        "https://catalog.roblox.com/v1/search/items/details" ..
        "?Category=12" ..
        "&Subcategory=39" ..
        "&SortType=0" ..
        "&SortAggregation=5" ..
        "&Limit=10" ..
        "&PageNumber=" .. tostring(page or 1) ..
        "&Keyword=" .. encoded

    local body = http(url)
    if type(body) ~= "string" or body == "" then
        return nil
    end

    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(body)
    end)

    if not ok or type(decoded) ~= "table" then
        return nil
    end

    return normalizeCatalogPage(decoded.data or {})
end

local function doSearch(keyword, page)
    keyword = tostring(keyword or "")
    page = tonumber(page) or 1

    Status.Text = "Searching emotes..."
    PageLabel.Text = "Page " .. tostring(page)

    local result = searchWithAvatarEditor(keyword)

    if result and #result > 0 then
        return result, "Marketplace"
    end

    result = searchWithHttp(keyword, page)

    if result and #result > 0 then
        return result, "HTTP"
    end

    return nil, nil
end

local function loadPage(page)
    CurrentPage = math.max(1, tonumber(page) or 1)

    task.spawn(function()
        local data, source = doSearch(CurrentKeyword, CurrentPage)

        if data and #data > 0 then
            showResults(data)
            Status.Text = "Loaded " .. tostring(#data) .. " emotes (" .. tostring(source) .. ")."
            PageLabel.Text = "Page " .. tostring(CurrentPage)
        elseif CurrentPage == 1 and CurrentKeyword == "" then
            showResults(FALLBACK)
            Status.Text = "Marketplace unavailable. Showing fallback emotes."
            PageLabel.Text = "Page 1 • Offline fallback"
        else
            showResults({})
            Status.Text = "No results or catalog access is unavailable."
            PageLabel.Text = "Page " .. tostring(CurrentPage)
        end
    end)
end

