local function showToast(text)

    toastSerial += 1

    local id = toastSerial

    Toast.Text = tostring(text)

    Toast.Visible = true

    Toast.Position =
        UDim2.new(
            0.5,
            -135,
            1,
            8
        )

    TweenService:Create(

        Toast,

        TweenInfo.new(
            0.20,
            Enum.EasingStyle.Quad
        ),

        {
            Position =
                UDim2.new(
                    0.5,
                    -135,
                    1,
                    -42
                )
        }

    ):Play()

    task.delay(2, function()

        if id ~= toastSerial then
            return
        end

        TweenService:Create(

            Toast,

            TweenInfo.new(
                0.20
            ),

            {
                Position =
                    UDim2.new(
                        0.5,
                        -135,
                        1,
                        8
                    )
            }

        ):Play()

        task.wait(0.2)

        if id == toastSerial then
            Toast.Visible = false
        end

    end)

end

