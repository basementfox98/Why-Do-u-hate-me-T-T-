local Sorts = {
    {Enum.CatalogSortType.Relevance,"Relevance"},
    {Enum.CatalogSortType.PriceHighToLow,"Price High→Low"},
    {Enum.CatalogSortType.PriceLowToHigh,"Price Low→High"},
    {Enum.CatalogSortType.MostFavorited,"Most Favorited"},
    {Enum.CatalogSortType.RecentlyCreated,"Recently Created"},
    {Enum.CatalogSortType.Bestselling,"Bestselling"},
}
local SortIndex = 1

local httpCatalog

local function getCatalogPage(keyword)
    -- Keep AvatarEditorService as a fallback for normal Roblox environments.
    -- The public Marketplace endpoint is attempted first because executor clients
    -- can be denied AvatarEditorService AssetRead capability.
    local publicPage = httpCatalog(keyword, nil)
    if publicPage then
        return publicPage
    end

    local params
    local made = pcall(function()
        params = CatalogSearchParams.new()
        params.SearchKeyword = keyword or ""
        params.CategoryFilter = Enum.CatalogCategoryFilter.None
        params.SalesTypeFilter = Enum.SalesTypeFilter.All
        params.AssetTypes = {Enum.AvatarAssetType.EmoteAnimation}
        params.IncludeOffSale = true
        params.SortType = Sorts[SortIndex][1]
        params.Limit = PAGE_SIZE
    end)
    if not made or not params then return nil end

    local ok,result = pcall(function()
        return AvatarEditorService:SearchCatalog(params)
    end)
    if not ok then
        ok,result = pcall(function()
            return AvatarEditorService:SearchCatalogAsync(params)
        end)
    end
    if ok then return result end
    return nil
end

-- HTTP fallback. Uses Roblox public catalog endpoint, not player inventory.
local HttpRequest = getRequestFunction()

local function httpGet(url)
    if HttpRequest then
        local ok,res = pcall(function()
            return HttpRequest({Url=url,Method="GET",Headers={Accept="application/json"}})
        end)
        if ok and res and type(res.Body) == "string" and #res.Body > 20 then return res.Body end
    end
    local ok,res = pcall(function() return game:HttpGet(url) end)
    if ok and type(res) == "string" and #res > 20 then return res end
end

local HttpMode = false
local HttpCursor
local HttpPrevCursors = {}

httpCatalog = function(keyword,cursor)
    local httpSort = math.max(0, math.min(5, SortIndex - 1))
    local url =
        "https://catalog.roblox.com/v1/search/items/details" ..
        "?Category=12&Subcategory=39&SortType=" .. tostring(httpSort) .. "&SortAggregation=5&Limit=10"

    if keyword and keyword ~= "" then
        url = url .. "&Keyword=" .. HttpService:UrlEncode(keyword)
    end

    if cursor and cursor ~= "" then
        url = url .. "&Cursor=" .. HttpService:UrlEncode(cursor)
    end

    local raw = httpGet(url)
    if not raw then return nil end

    local ok,data = pcall(function()
        return HttpService:JSONDecode(raw)
    end)

    if not ok or type(data) ~= "table" or type(data.data) ~= "table" then
        return nil
    end

    return {
        data = data.data,
        nextCursor = data.nextPageCursor,
    }
end

