local function redraw()
    local list = filtered()
    local total = math.max(1,math.ceil(#list/State.PageSize))
    State.Page = math.clamp(State.Page,1,total)

    local first = (State.Page-1)*State.PageSize+1

    for i=1,State.PageSize do
        local card = getCard(i)
        local e = list[first+i-1]

        card.Visible = e ~= nil
        if e then
            local img = card:FindFirstChild("Image")
            local name = card:FindFirstChild("Name")
            local p = card:FindFirstChild("Play")

            img.Image = "rbxthumb://type=Asset&id="..e.id.."&w=150&h=150"
            name.Text = e.name

            -- Avoid creating repeated click connections.
            if p:GetAttribute("Bound") ~= true then
                p:SetAttribute("Bound",true)
                p.MouseButton1Click:Connect(function()
                    local currentName = name.Text
                    for _,x in ipairs(Emotes) do
                        if x.name == currentName then
                            State.Selected = x
                            PTitle.Text = x.name
                            PSub.Text = "Animation ID: "..x.id
                            Cover.Image = "rbxthumb://type=Asset&id="..x.id.."&w=300&h=300"
                            playAnimation(x.id)
                            break
                        end
                    end
                end)
            end
        end
    end

    PageLabel.Text = "Page "..State.Page.." / "..total
end

Search:GetPropertyChangedSignal("Text"):Connect(function()
    State.Page = 1
    redraw()
end)

Prev.MouseButton1Click:Connect(function()
