--==============================================================
stopCurrentEmote = function()
    local track = State.CurrentTrack
    State.CurrentTrack = nil
    State.Paused = false

    if track then
        pcall(function()
            track:Stop(Settings.FadeOut)
        end)
        pcall(function()
            track:Destroy()
        end)
    end
end

local function resolveAnimationId(assetId)
    local id = numericId(assetId)
    if not id then return nil end

    local resolved = "rbxassetid://" .. tostring(id)

    -- Same resolution approach as GazeOld.
    pcall(function()
        local objects = game:GetObjects(resolved)
        if objects and #objects > 0 then
            local obj = objects[1]
            local anim = obj:IsA("Animation")
                and obj
                or obj:FindFirstChildWhichIsA("Animation", true)

            if anim and anim.AnimationId and anim.AnimationId ~= "" then
                resolved = anim.AnimationId
            end
        end
    end)

    return resolved
end

local function playEmote(assetId, name)
    local id = numericId(assetId)
    if not id then
        toast("Invalid emote ID")
        return false
    end

    local animator = getAnimator()
    if not animator then
        toast("Character / Animator not ready")
        return false
    end

    stopCurrentEmote()

    local animation = Instance.new("Animation")
    animation.Name = "SaikiEmote_" .. tostring(id)
    animation.AnimationId = resolveAnimationId(id) or ("rbxassetid://" .. tostring(id))

    local ok, track = pcall(function()
        return animator:LoadAnimation(animation)
    end)

    if not ok or not track then
        animation:Destroy()
        toast("Could not load animation " .. tostring(id))
        return false
    end

    -- Gaze-style playback controls.
    pcall(function()
        track.Priority = Settings.HighPriority
            and Enum.AnimationPriority.Action4
            or Enum.AnimationPriority.Action

        track.Looped = Settings.Looped

        if Settings.StopOtherAnimations then
            for _, other in ipairs(animator:GetPlayingAnimationTracks()) do
                if other ~= track and other.Priority ~= track.Priority then
                    pcall(function()
                        other:Stop(Settings.FadeOut)
                    end)
                end
            end
        end

        track:Play(Settings.FadeIn, math.max(0.001,Settings.Weight), Settings.Speed)

        -- Setting these after Play is more reliable on some executors.
        pcall(function()
            track:AdjustSpeed(Settings.Speed)
            track:AdjustWeight(math.max(0.001,Settings.Weight))
        end)

        if track.Length and track.Length > 0 then
            track.TimePosition = math.clamp(Settings.TimePosition,0,1) * track.Length
        end
    end)

    State.CurrentTrack = track
    State.Paused = false
    State.Selected = {
        Id = id,
        AssetId = id,
        Name = tostring(name or ("Emote " .. id)),
    }

    setPlaybackHUD(track, name or ("Emote " .. id))

    track.Stopped:Connect(function()
        if State.CurrentTrack == track then
            State.CurrentTrack = nil
            State.Paused = false
            PlaybackHUD.Visible = false
        end
        pcall(function() animation:Destroy() end)
    end)

    -- Keep the Animation object alive until the track has definitely loaded.
    task.delay(2,function()
        if not track.IsPlaying then
            pcall(function() animation:Destroy() end)
        end
    end)

    toast("Playing • " .. tostring(name or id))
    return true
end

