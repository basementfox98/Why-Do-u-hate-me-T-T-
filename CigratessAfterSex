function RenderCurrentTab()
    ClearList()

    if CurrentTab == "Settings" then
        Search.Visible = false
        List.Visible = true

        local settingsItems = {
            {"Animation Speed", string.format("%.1fx", Settings.speed), "speed"},
            {"Loop Emote", Settings.loop and "ON" or "OFF", "loop"},
            {"Show Emote HUD", Settings.showHUD and "ON" or "OFF", "hud"},
            {"Stop On Movement", Settings.stopOnMovement and "ON" or "OFF", "movement"},
        }

        for i, item in ipairs(settingsItems) do
            local row = New("Frame", {
                Size = UDim2.new(1, -4, 0, 52),
                BackgroundColor3 = PANEL,
                BorderSizePixel = 0,
                LayoutOrder = i,
            }, List)
            Corner(row, 8)
            Stroke(row, STROKE, 1)

            New("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(12, 8),
                Size = UDim2.new(1, -130, 0, 18),
                Font = FONT_BOLD,
                Text = item[1],
                TextSize = 11,
                TextColor3 = TEXT,
                TextXAlignment = Enum.TextXAlignment.Left,
            }, row)

            local control = New("TextButton", {
                Position = UDim2.new(1, -112, 0.5, -16),
                Size = UDim2.fromOffset(100, 32),
                BackgroundColor3 = PANEL2,
                BorderSizePixel = 0,
                AutoButtonColor = false,
                Font = FONT_BOLD,
                Text = item[2],
                TextSize = 10,
                TextColor3 = item[2] == "ON" and GREEN or TEXT,
            }, row)
            Corner(control, 6)
            Stroke(control, STROKE, 1)

            if item[3] == "speed" then
                control.MouseButton1Click:Connect(function()
                    local nextSpeed = Settings.speed + 0.25
                    if nextSpeed > 2.5 then
                        nextSpeed = 0.25
                    end
                    Settings.speed = nextSpeed
                    ApplySpeed()
                    RenderCurrentTab()
                end)
            elseif item[3] == "loop" then
                control.MouseButton1Click:Connect(function()
                    Settings.loop = not Settings.loop
                    if CurrentTrack then
                        CurrentTrack.Looped = Settings.loop
                    end
                    RenderCurrentTab()
                end)
            elseif item[3] == "hud" then
                control.MouseButton1Click:Connect(function()
                    Settings.showHUD = not Settings.showHUD
                    if not Settings.showHUD then
                        Hud.Visible = false
                    elseif CurrentTrack then
                        Hud.Visible = true
                    end
                    RenderCurrentTab()
                end)
            elseif item[3] == "movement" then
                control.MouseButton1Click:Connect(function()
                    Settings.stopOnMovement = not Settings.stopOnMovement
                    RenderCurrentTab()
                end)
            end
        end

        return
    end

    Search.Visible = true

    local query = string.lower(Search.Text or "")
    local data = {}

    if CurrentTab == "Emotes" then
        for _, emote in ipairs(Emotes) do
            if query == "" or string.find(string.lower(emote.name), query, 1, true) then
                table.insert(data, emote)
            end
        end
    elseif CurrentTab == "Favorites" then
        for _, favId in ipairs(Favorites) do
            for _, emote in ipairs(Emotes) do
                if emote.id == favId then
                    if query == "" or string.find(string.lower(emote.name), query, 1, true) then
                        table.insert(data, emote)
                    end
                    break
                end
            end
        end
    end

    if #data == 0 then
        New("TextLabel", {
            Size = UDim2.new(1, -4, 0, 70),
            BackgroundTransparency = 1,
            Font = FONT_BOLD,
            Text = CurrentTab == "Favorites"
                and "No favorite emotes yet."
                or "No emotes found.",
            TextSize = 12,
            TextColor3 = SUBTEXT,
            TextWrapped = true,
        }, List)
    else
        for i, emote in ipairs(data) do
            CreateEmoteCard(emote, i)
        end
    end
end

