local function getGuiParent()
    -- Executor UI root, when available.
    local ok, hui = pcall(function()
        if type(gethui) == "function" then
            return gethui()
        end
    end)

    if ok and hui then
        return hui
    end

    -- Normal Roblox client fallback.
    local ok2, pg = pcall(function()
        return LocalPlayer:WaitForChild("PlayerGui", 5)
    end)

    if ok2 and pg then
        return pg
    end

    -- Last fallback.
    local ok3, cg = pcall(function()
        return game:GetService("CoreGui")
    end)

    if ok3 and cg then
        return cg
    end

    return nil
end

local UIParent = getGuiParent()
if not UIParent then
    warn("[Saiki Emotes V2] Could not find a GUI parent.")
    return
end

