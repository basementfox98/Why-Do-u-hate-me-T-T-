-- Active-tab gradient: exactly one tab receives the animated gradient at a time.
-- Inactive tabs remain clean/flat and immediately return to their normal surface.
local TabGradients = {}
local function CreateTabGradient(button)
    local gradient = Instance.new("UIGradient")
    gradient.Rotation = 0
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, BLACK_2),
        ColorSequenceKeypoint.new(0.38, RED),
        ColorSequenceKeypoint.new(0.58, BRIGHT_RED),
        ColorSequenceKeypoint.new(1, BLACK_2),
    })
    gradient.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.08),
        NumberSequenceKeypoint.new(0.5, 0.0),
        NumberSequenceKeypoint.new(1, 0.08),
    })
    gradient.Parent = button
    TabGradients[button] = gradient
    return gradient
end

CreateTabGradient(TabEmotes)
CreateTabGradient(TabFavorites)
CreateTabGradient(TabCopy)
CreateTabGradient(TabSettings)

-- Keep the active tab's highlight moving. This is a single lightweight loop;
-- switching tabs instantly disables the old tab's gradient.
task.spawn(function()
    while true do
        task.wait(0.035)
        local t = ThemeDefinitions[CurrentThemeName] or ThemeDefinitions.Blood
        local offset = (os.clock() * 1.05) % 2 - 1
        for button, gradient in pairs(TabGradients) do
            local active = (button == TabEmotes and CurrentTab == "Emotes")
                or (button == TabFavorites and CurrentTab == "Favorites")
                or (button == TabCopy and CurrentTab == "Copy")
                or (button == TabSettings and CurrentTab == "Settings")
            if active and gradient.Parent then
                gradient.Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0.10),
                    NumberSequenceKeypoint.new(0.50, 0.0),
                    NumberSequenceKeypoint.new(1, 0.10),
                })
                gradient.Offset = Vector2.new(offset, 0)
                gradient.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, t.BLACK_2),
                    ColorSequenceKeypoint.new(0.34, t.ACCENT),
                    ColorSequenceKeypoint.new(0.50, t.BRIGHT),
                    ColorSequenceKeypoint.new(0.66, t.ACCENT),
                    ColorSequenceKeypoint.new(1, t.BLACK_2),
                })
            elseif gradient.Parent then
                gradient.Offset = Vector2.zero
                gradient.Transparency = NumberSequence.new(1)
            end
        end
    end
end)

local function RefreshActiveTabGradient()
    local t = ThemeDefinitions[CurrentThemeName] or ThemeDefinitions.Blood
    for button, gradient in pairs(TabGradients) do
        local active = (button == TabEmotes and CurrentTab == "Emotes")
            or (button == TabFavorites and CurrentTab == "Favorites")
            or (button == TabCopy and CurrentTab == "Copy")
            or (button == TabSettings and CurrentTab == "Settings")
        if active then
            gradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, t.BLACK_2),
                ColorSequenceKeypoint.new(0.36, t.ACCENT),
                ColorSequenceKeypoint.new(0.52, t.BRIGHT),
                ColorSequenceKeypoint.new(0.68, t.ACCENT),
                ColorSequenceKeypoint.new(1, t.BLACK_2),
            })
            gradient.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.10),
                NumberSequenceKeypoint.new(0.50, 0.0),
                NumberSequenceKeypoint.new(1, 0.10),
            })
        else
            gradient.Transparency = NumberSequence.new(1)
        end
    end
end

