-- ANIMATION SYSTEM
------------------------------------------------------------

local function getHumanoid()

    local character =
        LocalPlayer.Character

    if not character then
        return nil
    end

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    return humanoid

end

local function stopCurrentEmote()

    local track =
        State.currentTrack

    if track then

        pcall(function()
            track:Stop(0.15)
        end)

        pcall(function()
            track:Destroy()
        end)

    end

    State.currentTrack = nil

end

local function playAnimation(assetId)

    assetId =
        tonumber(assetId)

    if not assetId then

        showToast(
            "Invalid animation ID"
        )

        return

    end

    local humanoid =
        getHumanoid()

    if not humanoid then

        showToast(
            "Character not ready"
        )

        return

    end

    stopCurrentEmote()

    local animation =
        Instance.new(
            "Animation"
        )

    animation.AnimationId =
        "rbxassetid://" ..
        tostring(assetId)

    local ok, track =
        pcall(function()

            return humanoid:LoadAnimation(
                animation
            )

        end)

    if not ok or not track then

        animation:Destroy()

        showToast(
            "Could not load animation"
        )

        return

    end

    pcall(function()

        track.Priority =
            Enum.AnimationPriority.Action4

    end)

    pcall(function()

        track.Looped = true

    end)

    pcall(function()

        track:Play(
            0.1,
            1,
            State.speed
        )

    end)

    State.currentTrack =
        track

    animation:Destroy()

    showToast(
        "Playing emote"
    )

end

------------------------------------------------------------
-- MOVEMENT STOP
------------------------------------------------------------

RunService.RenderStepped:Connect(function()

    if not State.stopWhenMoving then
        return
    end

    local track =
        State.currentTrack

    if not track then
        return
    end

    if not track.IsPlaying then
        return
    end

    local character =
        LocalPlayer.Character

    if not character then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not humanoid then
        return
    end

    local moving =
        humanoid.MoveDirection.Magnitude >
        0.05

    local state =
        humanoid:GetState()

    local airborne =
        state ==
        Enum.HumanoidStateType.Jumping
        or
        state ==
        Enum.HumanoidStateType.Freefall

    if moving or airborne then
        stopCurrentEmote()
    end

end)

