        Favorite.Text = active and "★" or "☆"
        Favorite.TextColor3 = active and RED or STAR_OFF
    end)

    -- The cover image itself is the play button.
    -- Use MouseButton1Click explicitly so desktop/executor input is
    -- guaranteed to reach the cover ImageButton. Activated is retained
    -- for touch/gamepad input, with a tiny guard against double firing.
    local lastCoverClick = 0
    local function PlayFromCover()
        local now = os.clock()
        if now - lastCoverClick < 0.08 then return end
        lastCoverClick = now
        PlayEmote(emote)
    end

    Cover.MouseButton1Click:Connect(PlayFromCover)
    Cover.Activated:Connect(PlayFromCover)
end

function RenderFavorites()
    ClearGrid()
    EmptyText.Visible = false

    local query = string.lower(Search.Text or "")
    local list = {}

    for _, id in ipairs(Favorites) do
        local emote = KnownEmotes[id]
        if emote and (query == "" or string.find(string.lower(emote.name), query, 1, true)) then
            table.insert(list, emote)
        end
    end

    if #list == 0 then
        EmptyText.Text = (#Favorites == 0)
            and "No favorite emotes yet.\nStar an emote in the EMOTES tab."
            or "Your favorites are not loaded in this session yet."
        EmptyText.Visible = true
    else
        for i, emote in ipairs(list) do
            if i > PAGE_SIZE then break end
            CreateCard(emote, i)
        end
    end

    GridHolder.CanvasPosition = Vector2.zero
    PageLabel.Text = "FAVORITES"
    PageArea.Visible = false
    PrevPage.Visible = false
    NextPage.Visible = false
end

-- Each Roblox catalog page contains 30 results. We expose those
-- as two lightweight UI pages of exactly 15 results each.
local function ReadCatalogPage(cache)
    local raw = Safe(function()
        return cache.pages:GetCurrentPage()
    end)

    if type(raw) ~= "table" then
        return {}
    end

    local entries = {}
    for _, entry in ipairs(raw) do
        local emote = ConvertCatalogEntry(entry)
        if emote then
            table.insert(entries, emote)
        end
    end

    cache.catalogEntries[cache.catalogPage] = entries
    local finished = false
    pcall(function() finished = cache.pages.IsFinished end)
    cache.catalogFinished[cache.catalogPage] = finished
    return entries
end

local function GetUIPageEntries(cache, uiPage)
    local catalogPage = math.floor((uiPage - 1) / 2) + 1
    local half = ((uiPage - 1) % 2) + 1

    while cache.catalogPage < catalogPage do
        if cache.catalogFinished[cache.catalogPage] then
            return {}, true
        end

        while cache.advancing do
            task.wait(0.02)
        end

        if cache.catalogPage >= catalogPage then
            break
        end

        cache.advancing = true
        local ok = pcall(function()
            cache.pages:AdvanceToNextPageAsync()
        end)
        cache.advancing = false

        if not ok then
            return {}, true
        end

        cache.catalogPage += 1
        ReadCatalogPage(cache)
    end

    local entries = cache.catalogEntries[catalogPage] or {}
    local fromIndex = half == 1 and 1 or 16
    local toIndex = half == 1 and 15 or 30

    local result = {}
    for i = fromIndex, math.min(toIndex, #entries) do
        table.insert(result, entries[i])
    end

    local finished = false
    if half == 2 then
        finished = cache.catalogFinished[catalogPage] == true
    else
        finished = cache.catalogFinished[catalogPage] == true and #entries <= 15
    end

    return result, finished
end

local function RenderCatalogEntries(entries, pageNumber, finished, generation)
    if generation ~= SearchGeneration or CurrentTab ~= "Emotes" then return end

    ClearGrid()
    EmptyText.Visible = false

    for i, emote in ipairs(entries) do
        if i > PAGE_SIZE then break end
        CreateCard(emote, i)
    end

    if #entries == 0 then
        EmptyText.Text = SearchQuery == ""
            and "No Roblox emotes were returned by the catalog."
            or "No emotes matched your search."
        EmptyText.Visible = true
    end

    GridHolder.CanvasPosition = Vector2.zero
    GridHolder.CanvasSize = UDim2.fromOffset(480, 232)

    PageLabel.Text = tostring(pageNumber) .. " / " .. (finished and tostring(pageNumber) or "...")
    PrevPage.Visible = pageNumber > 1
    NextPage.Visible = not finished
end

local function LoadCatalogPage(pageNumber)
    SearchGeneration += 1
    local generation = SearchGeneration
    pageNumber = math.max(1, tonumber(pageNumber) or 1)
    EmptyText.Visible = false
    ClearGrid()
    PageLabel.Text = "LOADING"

    local cache = CatalogCache[SearchQuery]
    if not cache then
        cache = {
            pages = nil,
            catalogPage = 0,
            catalogEntries = {},
            catalogFinished = {},
            uiPages = {},
            uiFinished = {},
            advancing = false,
        }
        CatalogCache[SearchQuery] = cache
    end

    -- Cached UI page: instant render.
    if cache.uiPages[pageNumber] then
        CurrentPage = pageNumber
        RenderCatalogEntries(cache.uiPages[pageNumber], pageNumber, cache.uiFinished[pageNumber], generation)
        return
    end

    task.spawn(function()
        -- Only the first UI page performs the actual catalog search.
        if not cache.pages then
            local pages = BuildCatalogPage(SearchQuery)
            if not pages then
                if generation == SearchGeneration then
                    EmptyText.Text = "Roblox catalog search failed."
                    EmptyText.Visible = true
                    PageLabel.Text = "ERROR"
                end
                return
            end

            cache.pages = pages
            cache.catalogPage = 1
            ReadCatalogPage(cache)
        end

        local entries, finished = GetUIPageEntries(cache, pageNumber)
        if generation ~= SearchGeneration or CurrentTab ~= "Emotes" then return end

        cache.uiPages[pageNumber] = entries
        cache.uiFinished[pageNumber] = finished

        CurrentPagesObject = cache.pages
        CurrentPage = pageNumber
        RenderCatalogEntries(entries, pageNumber, finished, generation)

        -- Prefetch the next 15-item UI page. If it is the second
        -- half of the same 30-result Roblox page, this costs nothing.
        local nextPage = pageNumber + 1
        if not cache.uiPages[nextPage] and not finished then
            task.spawn(function()
                local nextEntries, nextFinished = GetUIPageEntries(cache, nextPage)
                cache.uiPages[nextPage] = nextEntries
                cache.uiFinished[nextPage] = nextFinished
            end)
        end
    end)
end

local function NewSearch()
    CurrentPage = 1
    SearchQuery = Search.Text or ""
    CatalogCache[SearchQuery] = nil
    if CurrentTab == "Emotes" then
        LoadCatalogPage(1)
    end
end

