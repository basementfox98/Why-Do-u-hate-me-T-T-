--============================================================

local function SelectTab(tab)
    CurrentTab = tab

    local emotesActive = tab == "Emotes"
    TabEmotes.BackgroundColor3 = emotesActive and GLASS_2 or BLACK_2
    TabFavorites.BackgroundColor3 = emotesActive and BLACK_2 or GLASS_2
    TabEmotes.TextColor3 = emotesActive and WHITE or MUTED
    TabFavorites.TextColor3 = emotesActive and MUTED or WHITE
    EmoteTabStroke.Color = emotesActive and RED or DARK_RED
    FavoriteTabStroke.Color = emotesActive and DARK_RED or RED

    if tab == "Emotes" then
        PrevPage.Visible = true
        NextPage.Visible = true
        NewSearch()
    else
        RenderFavorites()
    end
end

TabEmotes.MouseButton1Click:Connect(function()
    SelectTab("Emotes")
end)

TabFavorites.MouseButton1Click:Connect(function()
    SelectTab("Favorites")
end)

Search.FocusLost:Connect(function(enterPressed)
    if enterPressed or CurrentTab == "Emotes" then
        SearchQuery = Search.Text or ""
        CurrentPage = 1
        LoadCatalogPage(1)
    end
end)

Search:GetPropertyChangedSignal("Text"):Connect(function()
    if CurrentTab == "Favorites" then
        RenderFavorites()
    end
end)

PrevPage.MouseButton1Click:Connect(function()
    if CurrentTab ~= "Emotes" or CurrentPage <= 1 then return end
    LoadCatalogPage(CurrentPage - 1)
end)

NextPage.MouseButton1Click:Connect(function()
    if CurrentTab ~= "Emotes" or not CurrentPagesObject then return end

    local finished = false
    pcall(function() finished = CurrentPagesObject.IsFinished end)
    if finished then return end

    LoadCatalogPage(CurrentPage + 1)
end)

