local function BuildCatalogPage(query)
    local params = CatalogSearchParams.new()
    params.SearchKeyword = query or ""
    params.CategoryFilter = Enum.CatalogCategoryFilter.None
    params.SalesTypeFilter = Enum.SalesTypeFilter.All
    params.AssetTypes = {Enum.AvatarAssetType.EmoteAnimation}
    params.IncludeOffSale = true
    params.Limit = PAGE_SIZE
    params.SortType = Enum.CatalogSortType.Relevance

    local ok, pages = pcall(function()
        return AvatarEditorService:SearchCatalog(params)
    end)

    if ok then return pages end
    return nil
end

local function ConvertCatalogEntry(entry)
    if type(entry) ~= "table" then return nil end

    local id = AssetId(entry.Id or entry.AssetId)
    local name = entry.Name or entry.name or entry.Title

    if not id or not name then return nil end

    local emote = {
        id = id,
        name = tostring(name),
    }

    KnownEmotes[id] = emote
    return emote
end

local function ClearGrid()
    for _, child in ipairs(Grid:GetChildren()) do
        if child:IsA("GuiObject") and child ~= GridLayout and child ~= GridPadding then
            child:Destroy()
        end
    end
end

