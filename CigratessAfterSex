--//============================================================
--// HTTP / DATABASE
--//============================================================

local function GetHttpFunction()
    local candidates = {
        request,
        http_request,
        (syn and syn.request),
        (http and http.request),
    }

    for _, fn in ipairs(candidates) do
        if type(fn) == "function" then
            return fn
        end
    end

    return nil
end

local function HttpGet(url)
    local requestFunction = GetHttpFunction()

    if requestFunction then
        local ok, response = pcall(requestFunction, {
            Url = url,
            Method = "GET",
            Headers = {
                ["Accept"] = "application/json",
                ["Cache-Control"] = "no-cache",
            },
        })

        if ok and response then
            local body = response.Body or response.body
            if type(body) == "string" and #body > 2 then
                return body
            end
        end
    end

    local ok, result = pcall(function()
        return game:HttpGet(url)
    end)

    if ok and type(result) == "string" and #result > 2 then
        return result
    end

    return nil
end

local function NormaliseEmote(entry)
    if type(entry) ~= "table" then
        return nil
    end

    local id = entry.id or entry.ID or entry.animationId or entry.animationID
    local name = entry.name or entry.Name or entry.title

    id = tonumber(id)

    if not id then
        return nil
    end

    if not name or tostring(name) == "" then
        return nil
    end

    return {
        id = id,
        name = tostring(name),
    }
end

local function LoadEmotes()
    -- Same emote database endpoint used by the supplied VEX script.
    -- The Saiki version does not embed VEX's private authentication secret.
    local url = "https://vexroscripts.com.tr/api/emotes.json?t=" .. tostring(math.floor(os.clock() * 1000))

    for attempt = 1, 3 do
        local raw = HttpGet(url)

        if raw and (raw:sub(1, 1) == "{" or raw:sub(1, 1) == "[") then
            local decoded = SafeCall(function()
                return HttpService:JSONDecode(raw)
            end)

            if type(decoded) == "table" then
                local source = decoded.data or decoded.emotes or decoded

                if type(source) == "table" then
                    local loaded = {}
                    local seen = {}

                    for _, entry in ipairs(source) do
                        local emote = NormaliseEmote(entry)

                        if emote and not seen[emote.id] then
                            seen[emote.id] = true
                            loaded[#loaded + 1] = emote
                        end
                    end

                    if #loaded > 0 then
                        table.sort(loaded, function(a, b)
                            return string.lower(a.name) < string.lower(b.name)
                        end)

                        Emotes = loaded
                        return true
                    end
                end
            end
        end

        if attempt < 3 then
            task.wait(1)
        end
    end

    return false
end

task.spawn(function()
    StatusText.Text = "LOADING DATABASE"

    local loaded = LoadEmotes()

    if not loaded then
        -- Do not pretend five fallback emotes are the full database.
        -- The user explicitly requested the complete VEX-sized database.
        Emotes = {}
        StatusText.Text = "DATABASE OFFLINE"
    else
        StatusText.Text = string.format("%d EMOTES", #Emotes)
    end

    task.defer(function()
        CurrentPage = 1
        if RenderCurrentTab then
            RenderCurrentTab()
        end
    end)
end)

--//============================================================
--// FAVORITES
--//============================================================

local function IsFavorite(id)
    return FavoritesSet[id] == true
end

local function ToggleFavorite(id)
    if IsFavorite(id) then
        FavoritesSet[id] = nil

        for index, favId in ipairs(Favorites) do
            if favId == id then
                table.remove(Favorites, index)
                break
            end
        end
    else
        FavoritesSet[id] = true
        table.insert(Favorites, id)
    end
end

local function GetFavoriteEmotes()
    local result = {}

    for _, favId in ipairs(Favorites) do
        for _, emote in ipairs(Emotes) do
            if emote.id == favId then
                table.insert(result, emote)
                break
            end
        end
    end

    return result
end

--//============================================================
--// ANIMATION PLAYER
--//============================================================

local function GetAnimator()
    local character = Player.Character or Player.CharacterAdded:Wait()
    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        return nil, nil
    end

    local animator = humanoid:FindFirstChildOfClass("Animator")

    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end

    return animator, humanoid
end

local function StopAllTracks()
    local animator = GetAnimator()

    if not animator then
        return
    end

    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        pcall(function()
            track:Stop(0.1)
        end)
    end
end

local function StopEmote()
    if HeartbeatConnection then
        HeartbeatConnection:Disconnect()
        HeartbeatConnection = nil
    end

    if CurrentTrack then
        pcall(function()
            CurrentTrack:Stop(0.12)
            CurrentTrack:Destroy()
        end)
    end

    CurrentTrack = nil

    if CurrentAnimation then
        CurrentAnimation:Destroy()
        CurrentAnimation = nil
    end

    CurrentEmote = nil
    Hud.Visible = false
    PauseButton.Text = "II"
    Progress.Size = UDim2.fromScale(0, 1)
    HudTime.Text = "Stopped"
end

local function UpdateHudText()
    HudSpeed.Text = string.format("Speed %.2fx", Settings.Speed)
    SpeedValue.Text = string.format("%.1fx", Settings.Speed)

    if CurrentEmote then
        HudName.Text = CurrentEmote.name
    else
        HudName.Text = "No emote"
    end
end

local function ApplySpeed()
    if CurrentTrack then
        pcall(function()
            CurrentTrack:AdjustSpeed(Settings.Speed)
        end)
    end

    UpdateHudText()
end

local function PlayEmote(emote)
    if not emote then
        return
    end

    local animator = GetAnimator()
    if not animator then
        return
    end

    StopEmote()
    StopAllTracks()

    local animation = Instance.new("Animation")
    animation.Name = "SaikiEmoteAnimation"
    animation.AnimationId = "rbxassetid://" .. tostring(emote.id)
    CurrentAnimation = animation

    local ok, track = pcall(function()
        return animator:LoadAnimation(animation)
    end)

    if not ok or not track then
        animation:Destroy()
        CurrentAnimation = nil
        StatusText.Text = "ANIMATION ERROR"
        task.delay(1.5, function()
            if StatusText then
                StatusText.Text = "READY"
            end
        end)
        return
    end

    CurrentTrack = track
    CurrentEmote = emote

    track.Priority = Enum.AnimationPriority.Action
    track.Looped = Settings.Loop

    local playOk = pcall(function()
        track:Play(0.12)
        track:AdjustSpeed(Settings.Speed)
    end)

    if not playOk then
        StopEmote()
        return
    end

    UpdateHudText()

    if Settings.ShowHUD then
        Hud.Visible = true
    end

    HeartbeatConnection = RunService.Heartbeat:Connect(function()
        if CurrentTrack ~= track then
            return
        end

        if not track.IsPlaying then
            StopEmote()
            return
        end

        if Settings.StopOnMovement then
            local _, humanoid = GetAnimator()

            if humanoid and humanoid.MoveDirection.Magnitude > 0.05 then
                StopEmote()
                return
            end
        end

        if Hud.Visible then
            local length = track.Length
            local position = track.TimePosition

            if length and length > 0 then
                Progress.Size = UDim2.new(
                    math.clamp(position / length, 0, 1),
                    0,
                    1,
                    0
                )

                HudTime.Text = string.format(
                    "%0.1f / %0.1f",
                    position,
                    length
                )
            else
                Progress.Size = UDim2.fromScale(0, 1)
                HudTime.Text = "Playing"
            end
        end
    end)
end

