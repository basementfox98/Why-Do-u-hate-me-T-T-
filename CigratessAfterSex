BackgroundBlur.Enabled = false
BackgroundBlur.Parent = Lighting

local BlurTween
local function SetBackgroundBlur(blurred, instant)
    if BlurTween then
        pcall(function() BlurTween:Cancel() end)
        BlurTween = nil
    end

    if blurred then
        BackgroundBlur.Enabled = true
        if instant then
            BackgroundBlur.Size = 18
        else
            BackgroundBlur.Size = 0
            BlurTween = TweenService:Create(BackgroundBlur, TweenInfo.new(0.26, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = 18})
            BlurTween:Play()
        end
    else
        if instant then
            BackgroundBlur.Size = 0
            BackgroundBlur.Enabled = false
        else
            BlurTween = TweenService:Create(BackgroundBlur, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = 0})
            BlurTween:Play()
            local tween = BlurTween
            task.spawn(function()
                tween.Completed:Wait()
                if BackgroundBlur.Size <= 0.05 then
                    BackgroundBlur.Enabled = false
                end
            end)
        end
    end
end

