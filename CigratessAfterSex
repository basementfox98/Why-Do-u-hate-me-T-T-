--// MOVEMENT STOP
local lastRootPosition

RunService.RenderStepped:Connect(function()
    if not Settings.StopWhenMoving then
        return
    end

    local character = Character

    if not character then
        return
    end

    local root = character:FindFirstChild("HumanoidRootPart")

    if not root then
        return
    end

    local currentPosition = root.Position

    if lastRootPosition then
        local moved = (
            currentPosition - lastRootPosition
        ).Magnitude > 0.1

        local jumping = false

        pcall(function()
            jumping =
                Humanoid:GetState()
                == Enum.HumanoidStateType.Jumping
        end)

        if moved or jumping then
            if State.CurrentTrack then
                pcall(function()
                    State.CurrentTrack:Stop(0.1)
                end)

                State.CurrentTrack = nil
            end
        end
    end

    lastRootPosition = currentPosition
end)

