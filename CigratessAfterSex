------------------------------------------------------------

local renderSerial = 0

local function renderResults()

    renderSerial += 1

    local thisRender =
        renderSerial

    clearList()

    local startIndex =
        ((State.page - 1) *
            EMOTES_PER_PAGE) + 1

    local endIndex =
        math.min(
            startIndex +
                EMOTES_PER_PAGE -
                1,

            #State.results
        )

    PageLabel.Text =
        "PAGE " ..
        tostring(
            State.page
        )

    for i = startIndex, endIndex do

        if thisRender ~= renderSerial then
            return
        end

        createEmoteCard(
            State.results[i],
            i - startIndex + 1
        )

        -- Spread UI creation over frames.
        if
            (i - startIndex + 1) % 2 == 0
        then
            task.wait()
        end

    end

    ListFrame.CanvasPosition =
        Vector2.new(
            0,
            0
        )

end

------------------------------------------------------------
-- CATALOG SEARCH
------------------------------------------------------------

local searchSerial = 0

local function searchEmotes(query)

    searchSerial += 1

    local thisSearch =
        searchSerial

    State.loading = true

    State.page = 1

    clearList()

    PageLabel.Text =
        "SEARCHING"

    local ok, pages =
        pcall(function()

            local params =
                CatalogSearchParams.new()

            params.SearchKeyword =
                query or ""

            params.CategoryFilter =
                Enum.CatalogCategoryFilter.AvatarAnimations

            params.IncludeOffSale =
                true

            return AvatarEditorService:
                SearchCatalogAsync(
                    params
                )

        end)

    if
        thisSearch ~=
        searchSerial
    then
        return
    end

    if not ok or not pages then

        State.loading = false

        PageLabel.Text =
            "PAGE 1"

        showToast(
            "Emote search failed"
        )

        return

    end

    local items = {}

    local currentPage

    local pageOk =
        pcall(function()

            currentPage =
                pages:GetCurrentPage()

        end)

    if pageOk and currentPage then

        for _, item in ipairs(
            currentPage
        ) do

            local id =
                item.Id

            local name =
                item.Name

            if id then

                table.insert(
                    items,
                    {
                        id = id,
                        name =
                            name or
                            "Emote"
                    }
                )

            end

        end

    end

    State.results =
        items

    State.loading = false

    if #items == 0 then

        PageLabel.Text =
            "NO RESULTS"

        showToast(
            "No emotes found"
        )

        return

    end

    renderResults()

end

------------------------------------------------------------
-- SEARCH DEBOUNCE
------------------------------------------------------------

local searchToken = 0

local function requestSearch()

    searchToken += 1

    local token =
        searchToken

    local query =
        Search.Text

    State.search =
        query

    task.delay(
        0.35,
        function()

            if token ~= searchToken then
                return
            end

            searchEmotes(
                query
            )

        end
    )

end

Search.FocusLost:Connect(
    requestSearch
)

