--============================================================
-- EMOTE PLAYBACK
--============================================================

local function GetAnimator()
    local character = Player.Character or Player.CharacterAdded:Wait()
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return nil, nil end

    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end
    return animator, humanoid
end

local function StopEmote()
    if TrackConnection then
        TrackConnection:Disconnect()
        TrackConnection = nil
    end

    if CurrentTrack then
        pcall(function() CurrentTrack:Stop(0.12) end)
    end
    CurrentTrack = nil

    if CurrentAnimation then
        CurrentAnimation:Destroy()
        CurrentAnimation = nil
    end

    CurrentEmote = nil
    Hud.Visible = false
    Pause.Text = "II"
end

local function PlayEmote(emote)
    local animator = GetAnimator()
    if not animator or not emote or not emote.id then return end

    StopEmote()

    local animation = Instance.new("Animation")
    animation.AnimationId = "rbxassetid://" .. tostring(emote.id)
    CurrentAnimation = animation

    local ok, track = pcall(function()
        return animator:LoadAnimation(animation)
    end)

    if not ok or not track then
        StopEmote()
        return
    end

    CurrentEmote = emote
    CurrentTrack = track
    track.Priority = Enum.AnimationPriority.Action4
    track.Looped = Settings.Looped

    local played = pcall(function()
        track:Play(0.1, 1, Settings.Speed)
    end)

    if not played then
        StopEmote()
        return
    end

    HudName.Text = emote.name
    HudSpeed.Text = string.format("%.2fx", Settings.Speed)
    Hud.Visible = true

    TrackConnection = RunService.Heartbeat:Connect(function()
        if not CurrentTrack or CurrentTrack ~= track then return end

        if not track.IsPlaying then
            StopEmote()
            return
        end

        if Settings.StopOnMovement then
            local _, humanoid = GetAnimator()
            if humanoid and humanoid.MoveDirection.Magnitude > 0.05 then
                StopEmote()
                return
            end
        end
    end)
end

