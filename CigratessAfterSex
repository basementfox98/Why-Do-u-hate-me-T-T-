        if not State.StopWhenMoving then
            return
        end

        local track =
            State.CurrentTrack

        if not track then
            return
        end

        if not track.IsPlaying then
            return
        end

        local character =
            LocalPlayer.Character

        if not character then
            return
        end

        local humanoid =
            character:
                FindFirstChildOfClass(
                    "Humanoid"
                )

        if not humanoid then
            return
        end

        if
            humanoid.MoveDirection.Magnitude
                > 0.05
        then

            stopEmote()

        end

    end)

