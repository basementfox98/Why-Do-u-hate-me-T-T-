local AmbientLayer = Instance.new("Frame")
AmbientLayer.Name = "SaikiAmbientLayer"
AmbientLayer.Size = UDim2.fromScale(1,1)
AmbientLayer.Position = UDim2.fromScale(0,0)
AmbientLayer.BackgroundTransparency = 1
AmbientLayer.BorderSizePixel = 0
AmbientLayer.ZIndex = 0
AmbientLayer.Parent = Main

local CHERRY_LEAVES = {
    "rbxthumb://type=Asset&id=138495845541885&w=420&h=420",
    "rbxthumb://type=Asset&id=98467848507036&w=420&h=420",
    "rbxthumb://type=Asset&id=125300690495092&w=420&h=420"
}
local SNOW_FLAKES = {
    "rbxthumb://type=Asset&id=103375221051022&w=420&h=420",
    "rbxthumb://type=Asset&id=138994720&w=420&h=420"
}

local ambient = {}
local rng = Random.new()
for i=1,24 do
    local leaf = Instance.new("ImageLabel")
    leaf.Name = "AmbientParticle_"..i
    leaf.AnchorPoint = Vector2.new(.5,.5)
    leaf.Size = UDim2.fromOffset(rng:NextInteger(12,26),rng:NextInteger(12,26))
    leaf.Position = UDim2.new(rng:NextNumber(0,1),0,rng:NextNumber(-.2,1),0)
    leaf.BackgroundTransparency = 1
    leaf.BorderSizePixel = 0
    leaf.ZIndex = 0
    leaf.Image = CHERRY_LEAVES[((i-1)%#CHERRY_LEAVES)+1]
    leaf.ImageColor3 = Color3.fromRGB(255,150,205)
    leaf.ImageTransparency = rng:NextNumber(.05,.22)
    leaf.Rotation = rng:NextNumber(0,360)
    leaf.Parent = AmbientLayer
    table.insert(ambient,{
        object=leaf,
        x=leaf.Position.X.Scale,
        y=leaf.Position.Y.Scale,
        speed=rng:NextNumber(.045,.095),
        sway=rng:NextNumber(.012,.035),
        phase=rng:NextNumber(0,math.pi*2),
        swaySpeed=rng:NextNumber(.8,1.7),
        rotation=rng:NextNumber(-75,75),
        snowRotation=rng:NextNumber(-10,10),
        base=rng:NextNumber(.05,.18)
    })
end

local gradientTime = 0
RunService.RenderStepped:Connect(function(dt)
    gradientTime += dt

    -- Opaque moving Saiki gradient in both themes.
    local hue = (gradientTime * .035) % 1
    if State.Dark then
        Main.BackgroundColor3 = Color3.fromRGB(8,8,12)
        Gradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,Color3.fromHSV((hue+.78)%1,.55,.12)),
            ColorSequenceKeypoint.new(.5,Color3.fromHSV((hue+.68)%1,.45,.09)),
            ColorSequenceKeypoint.new(1,Color3.fromHSV((hue+.92)%1,.50,.12))
        })
    else
        Main.BackgroundColor3 = Color3.fromRGB(255,255,255)
        Gradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,Color3.fromRGB(255,224,240)),
            ColorSequenceKeypoint.new(.5,Color3.fromRGB(236,224,255)),
            ColorSequenceKeypoint.new(1,Color3.fromRGB(222,249,241))
        })
    end
    Gradient.Rotation = (25 + gradientTime*5) % 360

    for _,d in ipairs(ambient) do
        d.y += d.speed*dt
        if d.y > 1.12 then
            d.y = rng:NextNumber(-.18,-.05)
            d.x = rng:NextNumber(-.05,1.05)
            d.phase = rng:NextNumber(0,math.pi*2)
        end
        local drift = math.sin(gradientTime*d.swaySpeed+d.phase)*d.sway
        d.object.Position = UDim2.new(d.x+drift,0,d.y,0)
        if State.Dark then
            d.object.Image = SNOW_FLAKES[((tonumber(d.object.Name:match("%d+")) or 1)-1)%#SNOW_FLAKES+1]
            d.object.ImageColor3 = Color3.new(1,1,1)
            d.object.Rotation += d.snowRotation*dt
            d.object.ImageTransparency = math.clamp(d.base + ((d.y-.78)/.34)*.78,.04,1)
        else
            d.object.Image = CHERRY_LEAVES[((tonumber(d.object.Name:match("%d+")) or 1)-1)%#CHERRY_LEAVES+1]
            d.object.ImageColor3 = Color3.fromRGB(255,150,205)
            d.object.Rotation += d.rotation*dt
            d.object.ImageTransparency = math.clamp(d.base + ((d.y-.78)/.34)*.70,.06,1)
        end
    end
end)

