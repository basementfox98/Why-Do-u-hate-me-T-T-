--============================================================
-- FAVORITES RENDER
--============================================================

function RenderFavorites()
    ClearGrid()
    EmptyText.Visible = false

    local query = string.lower(Search.Text or "")
    local list = {}

    for _, id in ipairs(Favorites) do
        local emote = KnownEmotes[id]
        if emote and (query == "" or string.find(string.lower(emote.name), query, 1, true)) then
            table.insert(list, emote)
        end
    end

    if #list == 0 then
        EmptyText.Text = (#Favorites == 0)
            and "No favorite emotes yet.\nStar an emote in the EMOTES tab."
            or "Your favorites are not loaded on this page yet.\nOpen the EMOTES tab and favorite them again if needed."
        EmptyText.Visible = true
    else
        for i, emote in ipairs(list) do
            CreateCard(emote, i)
        end
    end

    PageLabel.Text = "FAVORITES"
    PrevPage.Visible = false
    NextPage.Visible = false
end

--============================================================
-- CATALOG RENDER
--============================================================

local function RenderCatalogPages(pages, generation, pageNumber)
    if generation ~= SearchGeneration or CurrentTab ~= "Emotes" then return end

    local entries = Safe(function()
        return pages:GetCurrentPage()
    end)

    if type(entries) ~= "table" then
        EmptyText.Text = "Unable to read the Roblox emote catalog."
        EmptyText.Visible = true
        return
    end

    ClearGrid()
    EmptyText.Visible = false

    local count = 0
    for _, entry in ipairs(entries) do
        local emote = ConvertCatalogEntry(entry)
        if emote then
            count += 1
            CreateCard(emote, count)
        end
    end

    if count == 0 then
        EmptyText.Text = SearchQuery == ""
            and "No Roblox emotes were returned by the catalog."
            or "No emotes matched your search."
        EmptyText.Visible = true
    end

    local finished = false
    pcall(function() finished = pages.IsFinished end)

    PageLabel.Text = tostring(pageNumber) .. " / " .. (finished and tostring(pageNumber) or "...")
    PrevPage.Visible = pageNumber > 1
    NextPage.Visible = not finished
end

local function LoadCatalogPage(pageNumber)
    SearchGeneration += 1
    local generation = SearchGeneration
    StatusText.Text = "LOADING"
    StatusDot.BackgroundColor3 = Color3.fromRGB(255, 190, 65)
    EmptyText.Visible = false
    ClearGrid()
    PageLabel.Text = "LOADING"

    task.spawn(function()
        local pages = BuildCatalogPage(SearchQuery)
        if not pages or generation ~= SearchGeneration or CurrentTab ~= "Emotes" then
            if generation == SearchGeneration then
                StatusText.Text = "ERROR"
                StatusDot.BackgroundColor3 = RED
                EmptyText.Text = "Roblox catalog search failed."
                EmptyText.Visible = true
            end
            return
        end

        -- AvatarEditorService exposes catalog pages and includes emote assets
        -- whether or not the local player owns them.
        for step = 2, pageNumber do
            local ok = pcall(function()
                if pages.IsFinished then return end
                pages:AdvanceToNextPageAsync()
            end)
            if not ok then break end
            if generation ~= SearchGeneration then return end
        end

        CurrentPagesObject = pages
        CurrentPage = pageNumber
        StatusText.Text = "CATALOG"
        StatusDot.BackgroundColor3 = GREEN
        RenderCatalogPages(pages, generation, pageNumber)
    end)
end

local function NewSearch()
    CurrentPage = 1
    SearchQuery = Search.Text or ""
    if CurrentTab == "Emotes" then
        LoadCatalogPage(1)
    end
end

