RunService.RenderStepped:Connect(function(dt)
    State.GradientTime += dt

    local hue =
        (State.GradientTime * 0.035) % 1

    local c1 = Color3.fromHSV(
        (hue + 0.92) % 1,
        0.12,
        1
    )

    local c2 = Color3.fromHSV(
        (hue + 0.05) % 1,
        0.10,
        1
    )

    local c3 = Color3.fromHSV(
        (hue + 0.48) % 1,
        0.10,
        1
    )

    Gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, c1),
        ColorSequenceKeypoint.new(0.5, c2),
        ColorSequenceKeypoint.new(1, c3),
    })

    MainStroke.Color = Color3.fromHSV(
        (hue + 0.9) % 1,
        0.18,
        0.95
    )
end)

