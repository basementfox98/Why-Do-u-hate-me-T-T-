local function create(className, properties, parent)

    local object = Instance.new(className)

    for key, value in pairs(properties or {}) do
        object[key] = value
    end

    object.Parent = parent

    return object
end

local function makeLabel(
    parent,
    text,
    size,
    position,
    font,
    textSize
)

    return create("TextLabel", {

        BackgroundTransparency = 1,

        Text = text,

        Size = size,

        Position = position,

        Font = font or Enum.Font.Gotham,

        TextSize = textSize or 12,

        TextColor3 =
            Color3.fromRGB(
                60,
                50,
                70
            ),

        TextXAlignment =
            Enum.TextXAlignment.Left,

        TextYAlignment =
            Enum.TextYAlignment.Center

    }, parent)
end

local function defineButton(button, radius, thickness)

    create("UICorner", {
        CornerRadius =
            UDim.new(
                0,
                radius or 10
            )
    }, button)

    create("UIStroke", {
        Thickness =
            thickness or 1,

        Transparency = 0.72,

        Color =
            Color3.fromRGB(
                125,
                105,
                140
            )
    }, button)

end

