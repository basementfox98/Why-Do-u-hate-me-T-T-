local function makeDraggable(
    object,
    handle,
    canDrag
)

    local dragging = false

    local dragStart

    local startPosition

    local dragInput

    handle.InputBegan:
        Connect(function(input)

            if not canDrag() then
                return
            end

            if
                input.UserInputType ==
                    Enum.UserInputType.MouseButton1
                or
                input.UserInputType ==
                    Enum.UserInputType.Touch
            then

                dragging = true

                dragStart =
                    input.Position

                startPosition =
                    object.Position

                input.Changed:
                    Connect(function()

                        if
                            input.UserInputState ==
                                Enum.UserInputState.End
                        then

                            dragging = false

                        end

                    end)

            end

        end)

    handle.InputChanged:
        Connect(function(input)

            if
                input.UserInputType ==
                    Enum.UserInputType.MouseMovement
                or
                input.UserInputType ==
                    Enum.UserInputType.Touch
            then

                dragInput = input

            end

        end)

    UserInputService.InputChanged:
        Connect(function(input)

            if
                input == dragInput
                and dragging
                and canDrag()
            then

                local delta =
                    input.Position -
                    dragStart

                object.Position =
                    UDim2.new(

                        startPosition.X.Scale,

                        startPosition.X.Offset +
                            delta.X,

                        startPosition.Y.Scale,

                        startPosition.Y.Offset +
                            delta.Y

                    )

            end

        end)

end

