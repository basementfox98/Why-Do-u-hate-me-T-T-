--==============================================================
-- CATALOG RENDER / PAGINATION
--==============================================================
local function renderCatalogPage(pageObject,pageNumber)
    renderSerial += 1
    local serial = renderSerial

    clearCardTable(CatalogCards)
    EmptyLabel.Visible = false

    local ok,current = pcall(function()
        return pageObject:GetCurrentPage()
    end)

    if not ok or type(current) ~= "table" or #current == 0 then
        EmptyLabel.Text = "No emotes found"
        EmptyLabel.Visible = true
        PageBox.Text = "Page " .. tostring(pageNumber)
        return
    end

    local count = 0
    for _,item in ipairs(current) do
        if serial ~= renderSerial then return end
        createEmoteCard(item,List,CatalogCards,false)
        count += 1
        if count % 5 == 0 then
            RunService.RenderStepped:Wait()
        end
    end

    PageBox.Text = "Page " .. tostring(pageNumber)
    Prev.Active = pageNumber > 1
    Next.Active = not pageObject.IsFinished
end

loadCatalog = function(keyword)
    State.RequestId += 1
    local requestId = State.RequestId

    State.Search = keyword or ""
    State.Page = 1
    State.CatalogPage = nil
    HttpMode = false
    HttpCursor = nil
    table.clear(HttpPrevCursors)

    EmptyLabel.Visible = false
    PageBox.Text = "Loading..."
    Prev.Active = false
    Next.Active = false
    State.Loading = true

    task.spawn(function()
        local result = getCatalogPage(State.Search)

        if requestId ~= State.RequestId then return end

        if result and result.data then
            HttpMode = true
            State.Loading = false
            HttpCursor = result.nextCursor
            clearCardTable(CatalogCards)
            for _,item in ipairs(result.data) do
                createEmoteCard(item,List,CatalogCards,false)
            end
            PageBox.Text = "Page 1"
            Prev.Active = false
            Next.Active = result.nextCursor ~= nil
            return
        end

        if result then
            State.CatalogPage = result
            State.Loading = false
            renderCatalogPage(result,1)
            return
        end

        -- Public catalog fallback if the first route could not be used.
        HttpMode = true
        local page = httpCatalog(State.Search,nil)
        State.Loading = false

        if requestId ~= State.RequestId then return end

        if page then
            HttpCursor = page.nextCursor
            clearCardTable(CatalogCards)
            for _,item in ipairs(page.data) do
                createEmoteCard(item,List,CatalogCards,false)
            end
            PageBox.Text = "Page 1"
            Prev.Active = false
            Next.Active = page.nextCursor ~= nil
        else
            EmptyLabel.Text = "Roblox Store unavailable\nCheck executor HTTP access"
            EmptyLabel.Visible = true
            PageBox.Text = "Page 1"
        end
    end)
end

local function nextPage()
    if State.Loading then return end

    if HttpMode then
        if not HttpCursor then return end
        State.Loading = true
        local oldCursor = HttpCursor
        local page = httpCatalog(State.Search,oldCursor)
        State.Loading = false

        if page then
            table.insert(HttpPrevCursors,oldCursor)
            HttpCursor = page.nextCursor
            State.Page += 1
            clearCardTable(CatalogCards)
            for _,item in ipairs(page.data) do
                createEmoteCard(item,List,CatalogCards,false)
            end
            PageBox.Text = "Page " .. tostring(State.Page)
            Prev.Active = State.Page > 1
            Next.Active = page.nextCursor ~= nil
        end
        return
    end

    local p = State.CatalogPage
    if not p or p.IsFinished then return end

    State.Loading = true
    local ok = pcall(function()
        p:AdvanceToNextPageAsync()
    end)
    State.Loading = false

    if ok then
        State.Page += 1
        renderCatalogPage(p,State.Page)
    else
        toast("Could not load next page")
    end
end

local function previousPage()
    if State.Loading or State.Page <= 1 then return end

    if HttpMode then
        local previousCursor = table.remove(HttpPrevCursors)
        if not previousCursor then return end

        State.Loading = true
        local page = httpCatalog(State.Search,previousCursor)
        State.Loading = false

        if page then
            HttpCursor = page.nextCursor
            State.Page -= 1
            clearCardTable(CatalogCards)
            for _,item in ipairs(page.data) do
                createEmoteCard(item,List,CatalogCards,false)
            end
            PageBox.Text = "Page " .. tostring(State.Page)
            Prev.Active = State.Page > 1
            Next.Active = page.nextCursor ~= nil
        end
        return
    end

    -- CatalogPages is forward-oriented; rebuild and advance to target page.
    local target = State.Page - 1
    loadCatalog(State.Search)

    task.spawn(function()
        for _=2,target do
            repeat task.wait() until not State.Loading
            if State.CatalogPage and not State.CatalogPage.IsFinished then
                nextPage()
            end
        end
    end)
end

