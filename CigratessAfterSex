--// CATALOG SEARCH
local function getCatalogPage(keyword)
    local params

    local success = pcall(function()
        params = CatalogSearchParams.new()

        params.SearchKeyword = keyword or ""

        params.CategoryFilter =
            Enum.CatalogCategoryFilter.None

        params.SalesTypeFilter =
            Enum.SalesTypeFilter.All

        params.AssetTypes = {
            Enum.AvatarAssetType.EmoteAnimation
        }

        params.IncludeOffSale = true

        params.Limit = PAGE_SIZE
    end)

    if not success or not params then
        return nil
    end

    local ok, result = pcall(function()
        return AvatarEditorService:SearchCatalog(params)
    end)

    if not ok then
        return nil
    end

    return result
end

--// RENDER PAGE
local renderId = 0

local function renderPage(pageObject, pageNumber)
    renderId += 1

    local thisRender = renderId

    clearList()

    EmptyLabel.Visible = false

    if not pageObject then
        EmptyLabel.Text = "Unable to load emotes"
        EmptyLabel.Visible = true

        StatusLabel.Text = "Catalog error"
        PageLabel.Text = "PAGE " .. tostring(pageNumber)

        return
    end

    local currentPage

    local success = pcall(function()
        currentPage = pageObject:GetCurrentPage()
    end)

    if not success or type(currentPage) ~= "table" then
        EmptyLabel.Text = "Unable to load emotes"
        EmptyLabel.Visible = true
        return
    end

    if #currentPage == 0 then
        EmptyLabel.Text = "No emotes found"
        EmptyLabel.Visible = true

        StatusLabel.Text = "0 emotes"
        PageLabel.Text = "PAGE " .. tostring(pageNumber)

        return
    end

    StatusLabel.Text =
        tostring(#currentPage)
        .. " emotes"

    PageLabel.Text =
        "PAGE "
        .. tostring(pageNumber)

    -- Incremental creation avoids creating everything
    -- in a single frame.
    task.spawn(function()
        for index, emote in ipairs(currentPage) do
            if thisRender ~= renderId then
                return
            end

            createEmoteCard(emote, index)

            if index % 2 == 0 then
                RunService.RenderStepped:Wait()
            end
        end

        if thisRender == renderId then
            List.CanvasSize = UDim2.new(
                0,
                0,
                0,
                Grid.AbsoluteContentSize.Y + 10
            )
        end
    end)
end

--// LOAD FIRST PAGE
local function loadFirstPage(keyword)
    State.RequestId += 1

    local requestId = State.RequestId

    State.Search = keyword or ""
    State.Page = 1

    State.Loading = true

    StatusLabel.Text = "Searching..."
    PageLabel.Text = "LOADING..."
    PrevButton.Active = false
    NextButton.Active = false

    clearList()
    EmptyLabel.Visible = false

    task.spawn(function()
        local result = getCatalogPage(State.Search)

        if requestId ~= State.RequestId then
            return
        end

        State.Loading = false
        State.CurrentPageObject = result

        if not result then
            EmptyLabel.Text = "Catalog unavailable"
            EmptyLabel.Visible = true

            StatusLabel.Text = "Search failed"
            PageLabel.Text = "PAGE 1"

            return
        end

        renderPage(result, 1)

        PrevButton.Active = false
        NextButton.Active = not result.IsFinished
    end)
end

--// NEXT PAGE
local function nextPage()
    if State.Loading then
        return
    end

    local current = State.CurrentPageObject

    if not current then
        return
    end

    if current.IsFinished then
        showToast("No more emotes")
        return
    end

    State.Loading = true

    StatusLabel.Text = "Loading next page..."
    NextButton.Active = false
    PrevButton.Active = false

    local success = pcall(function()
        current:AdvanceToNextPageAsync()
    end)

    if not success then
        State.Loading = false

        StatusLabel.Text = "Could not load page"
        NextButton.Active = true

        showToast("Could not load next page")
        return
    end

    State.Page += 1
    State.Loading = false

    renderPage(current, State.Page)

    PrevButton.Active = State.Page > 1
    NextButton.Active = not current.IsFinished
end

--// PREVIOUS PAGE
local function previousPage()
    if State.Loading then
        return
    end

    if State.Page <= 1 then
        return
    end

    local current = State.CurrentPageObject

    if not current then
        return
    end

    State.Loading = true

    StatusLabel.Text = "Loading previous page..."
    NextButton.Active = false
    PrevButton.Active = false

    local success = pcall(function()
        current:AdvanceToPreviousPageAsync()
    end)

    if not success then
        State.Loading = false

        StatusLabel.Text = "Could not load page"

        showToast("Could not load previous page")
        return
    end

    State.Page -= 1
    State.Loading = false

    renderPage(current, State.Page)

    PrevButton.Active = State.Page > 1
    NextButton.Active = not current.IsFinished
end

--// SEARCH DEBOUNCE
local searchToken = 0

local function searchEmotes()
    searchToken += 1

    local token = searchToken
    local query = Search.Text or ""

    task.delay(0.35, function()
        if token ~= searchToken then
            return
        end

        loadFirstPage(query)
    end)
end

Search:GetPropertyChangedSignal("Text"):Connect(searchEmotes)

Search.FocusLost:Connect(function()
    loadFirstPage(Search.Text)
end)

NextButton.Activated:Connect(nextPage)
PrevButton.Activated:Connect(previousPage)

