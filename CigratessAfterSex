-- Theme-aware UI registry
local ThemeObjects = {}
local ThemeStrokes = {}
local ThemeTextGradients = {}
local ThemeBorderGradients = {}
local BuildAmbientForTheme

local function SameColor(a, b)
    return a and b and a.R == b.R and a.G == b.G and a.B == b.B
end

local function ColorRole(color)
    local t = ThemeDefinitions[CurrentThemeName]
    if SameColor(color, t.BLACK) then return "BLACK" end
    if SameColor(color, t.BLACK_2) then return "BLACK_2" end
    if SameColor(color, t.GLASS) then return "GLASS" end
    if SameColor(color, t.GLASS_2) then return "GLASS_2" end
    if SameColor(color, t.HIGHLIGHT) then return "HIGHLIGHT" end
    if SameColor(color, t.ACCENT) then return "ACCENT" end
    if SameColor(color, t.BRIGHT) then return "BRIGHT" end
    if SameColor(color, t.DARK) then return "DARK" end
    if SameColor(color, t.WHITE) then return "WHITE" end
    if SameColor(color, t.SOFT) then return "SOFT" end
    if SameColor(color, t.MUTED) then return "MUTED" end
    if SameColor(color, t.STAR) then return "STAR" end
end

local function New(className, props, parent)
    local object = Instance.new(className)
    for k, v in pairs(props or {}) do object[k] = v end
    if props and props.BackgroundColor3 then
        local role = ColorRole(props.BackgroundColor3)
        if role then table.insert(ThemeObjects, {object = object, property = "BackgroundColor3", role = role}) end
    end
    if props and props.TextColor3 then
        local role = ColorRole(props.TextColor3)
        if role then table.insert(ThemeObjects, {object = object, property = "TextColor3", role = role}) end
    end
    if parent then object.Parent = parent end
    return object
end

local function Corner(object, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = object
    return c
end

local function Stroke(object, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or DARK_RED
    s.Thickness = thickness or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = object
    local role = ColorRole(s.Color)
    if role then table.insert(ThemeStrokes, {object = s, role = role}) end
    return s
end

local function TextGradient(object)
    local g = Instance.new("UIGradient")
    local t = ThemeDefinitions[CurrentThemeName] or ThemeDefinitions.Blood
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, t.WHITE),
        ColorSequenceKeypoint.new(0.50, t.SOFT),
        ColorSequenceKeypoint.new(1, t.ACCENT),
    })
    g.Parent = object
    table.insert(ThemeTextGradients, g)
    return g
end

local function MovingBorder(object, thickness)
    local stroke = Stroke(object, RED, thickness or 1.5)
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, DARK_RED),
        ColorSequenceKeypoint.new(0.28, BRIGHT_RED),
        ColorSequenceKeypoint.new(0.50, DARK_RED),
        ColorSequenceKeypoint.new(0.72, BRIGHT_RED),
        ColorSequenceKeypoint.new(1, DARK_RED),
    })
    gradient.Parent = stroke
    table.insert(ThemeBorderGradients, gradient)

    task.spawn(function()
        while object.Parent and stroke.Parent do
            local tween = TweenService:Create(
                gradient,
                TweenInfo.new(2.5, Enum.EasingStyle.Linear),
                {Rotation = gradient.Rotation + 360}
            )
            tween:Play()
            tween.Completed:Wait()
        end
    end)
    return stroke
end

local function Safe(fn, ...)
    local ok, result = pcall(fn, ...)
    if ok then return result end
    return nil
end

local function AssetId(value)
    return tonumber(tostring(value):match("%d+"))
end

local function Thumbnail(id)
    return "rbxthumb://type=Asset&id=" .. tostring(id) .. "&w=420&h=420"
end

